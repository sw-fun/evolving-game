cam = bpy.data.cameras.new("still")
cam.type = "ORTHO"
cam.ortho_scale = 2.6
eye = bpy.data.objects.new("still", cam)
scene.collection.objects.link(eye)
eye.location = (1.6, -3.2, 2.6)
aim = bpy.data.objects.new("aim", None)
scene.collection.objects.link(aim)
aim.location = (0.0, 0.0, 0.9)
look = eye.constraints.new("TRACK_TO")
look.target = aim
look.track_axis = "TRACK_NEGATIVE_Z"
look.up_axis = "UP_Y"
scene.camera = eye
scene.render.film_transparent = True
scene.render.resolution_x = scene.render.resolution_y = 256
for n in "walker ground water bridge wall gate".split():
    for m in "walker ground water bridge wall gate".split():
        o = bpy.data.objects[m]
        for p in [o] + list(o.children_recursive):
            p.hide_render = m != n
    scene.render.image_settings.file_format = "PNG"
    scene.render.image_settings.color_mode = "RGBA"
    scene.render.filepath = os.path.join(out, n + ".png")
    bpy.ops.render.render(write_still=True)

