## Menu: the menu bar along the top of the front door's screens and
## the road of levels (Front.xtl, Roads.xtl): Home, Hall (of deeds),
## Settings, Help and Leave, each a button and a key. Each mode decides
## what an item does; this draws the bar and the help shown over a
## screen, and says which item a key or a click is.
##
## The keys: H home, D the hall of deeds, S settings, ? help, Q leave
## (in small letters or capitals: the page gives small ones).
## Import: "mn:" u_se< "Menu"

"st:" u_se< "Strings"
"t:" u_se< "Text"

# :: Box Char
## The items, in order: 1 Home, 2 Hall, 3 Settings, 4 Help, 5 Leave.
l:items := "Home" "Hall" "Settings" "Help" "Leave"
# :: Box Char
## Each item's key, as a script names it.
l:keys := "H" "D" "S" "?" "Q"
# :: Char
## The bar's keys, said for a mode's help.
l:help := "Menu bar: H home, D hall of deeds, S settings, ? help, Q leave (or click it)."

# :: Char -> Int
## The item a key is (its number), or 0: a key's name, a capital or a
## small letter alike.
l:k_ey := { key ->
  k := l:keys i_ndexOf e_nclose st:u_pper key
  0 + (k <= t_ally l:keys) * k
}
## Where the buttons stand: the first's left edge, the step from one to
## the next, a button's width; its top and height.
h:left := 290
h:step := 180
h:wide := 170
h:top := 8
h:high := 38
# :: Num a => a -> Int
## The item a click (x y, in picture units, as a click event gives
## them) is on, or 0.
l:c_lick := { xy ->
  (x, y) := (f_loor f_irst xy, f_loor 2 s_elect xy)
  across := x - h:left
  k := 1 + f_loor (f_loat across) / f_loat h:step
  on := (y >= h:top) & (y <= h:top + h:high) & (across >= 0) & (k <= t_ally l:items) & (across - h:step * k - 1) < h:wide
  0 + on * k
}
## The k-th button: a framed box and its name with its key.
h:b_utton := { k ->
  x := h:left + h:step * k - 1
  name := (d_isclose k s_elect l:items) c_at " (" c_at (d_isclose k s_elect l:keys) c_at ")"
  "<rect x=\"" c_at (f_ormat x) c_at "\" y=\"" c_at (f_ormat h:top) c_at "\" width=\"" c_at (f_ormat h:wide) c_at "\" height=\"" c_at (f_ormat h:high) c_at "\" rx=\"8\" fill=\"#2a2418\" stroke=\"#c9a66b\" stroke-width=\"2\"/><text x=\"" c_at (f_ormat x + h:wide d_iv 2) c_at "\" y=\"" c_at (f_ormat h:top + 26) c_at "\" font-size=\"21\" fill=\"#f2ead8\" text-anchor=\"middle\">" c_at name c_at "</text>"
}
# :: Char
## The bar, drawn: a dark strip across the top of a 1200 wide picture
## and its five buttons.
l:bar := "<g id=\"menu\"><rect width=\"1200\" height=\"54\" fill=\"#0e0f15\" opacity=\"0.88\"/>" c_at (t:j_oin '{ k -> e_nclose h:b_utton k } e_ach r_ange t_ally l:items) c_at "</g>"
## The k-th line of the help, in the panel.
h:r_ow := { lines k -> "<text x=\"140\" y=\"" c_at (f_ormat 230 + 44 * k - 1) c_at "\" font-size=\"23\" fill=\"#e9e2d0\">" c_at (d_isclose k s_elect lines) c_at "</text>" }
# :: Char -> Char
## The help over a screen: a panel with a mode's help, a line a thing
## to know, and how to close it.
l:o_verlay := { help ->
  lines := (st:l_ines help) c_at e_nclose "Any key or a click closes this."
  "<g id=\"help\"><rect x=\"100\" y=\"110\" width=\"1000\" height=\"600\" rx=\"16\" fill=\"#15161e\" opacity=\"0.96\" stroke=\"#f2c14e\" stroke-width=\"3\"/><text x=\"140\" y=\"170\" font-size=\"44\" fill=\"#f2ead8\">Help</text>" c_at (t:j_oin '{ k -> e_nclose lines h:r_ow k } e_ach r_ange t_ally lines) c_at "</g>"
}
# :: Char -> Char
## A mode's help in words, for the caption.
l:s_aid := { help -> "Help. " c_at (" " st:j_oin st:l_ines help) c_at " Any key or a click closes this." }
