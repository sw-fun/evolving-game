## Passage: the second maze (the mode "raycaster"), walked freely and
## seen by rays. Its rules and its picture are X_eTaL-games' raycaster
## (Rays.xtl, used as it is at the pin); this is what makes it a mode
## of the castle. Its map and colors are raycaster.toml here.
##
## The state is (stage, the raycaster's own state, the keys held: a 1
## for each of up, down, left, right, W, S, A, D that is down). A key
## held moves you every tick, so turning and walking are smooth; a key
## event alone (a script's) is one step.
## Import: "ps:" u_se< "Passage"

"md:" u_se< "Mode"
"rc:" u_se< "Rays"
"sm:" u_se< "Sim"
"vw:" u_se< "View"

# :: Char
## The mode's name in scenarios.
l:mode := "raycaster"
# :: Char
## How it is used, a line a thing to know.
l:help := "The second maze: find the door.\nW S or Up Down: walk. Left Right: turn. A D: step sideways. Hold a key to keep going.\nEsc or the Map button leaves it."

# :: (Any a, Any b, Num c, Num d, Num e) => (Char, a, b) -> (((Char, Int, Int), Float, Box Char, Float, Char, c), (Float, Float, Float, Float, d), e)
## A new game: you at the start, no key held.
l:n_ew := { (file, world, seed) -> (md:s_tage file, rc:n_ew seed, 8 r_eshape 0) }
## The keys that can be held, by the page's code for each, and the
## names the raycaster knows them by.
h:codes := 38 40 37 39 87 83 65 68
h:names := "UP" "DOWN" "LEFT" "RIGHT" "w" "s" "a" "d"
## The keys held after one goes down (to 1) or comes up (to 0).
h:h_old := { held (code, to) -> (held * n_ot h:codes = code) + to * h:codes = code }
## The raycaster's state after every held key, from the k-th on, has
## acted once.
h:a_ct := { (r, held) k ->
  k > 8 ? r
  0 = k s_elect held ? (r, held) h:a_ct k + 1
  ((r rc:k_ey d_isclose k s_elect h:names), held) h:a_ct k + 1
}
# :: (Any a, Num b, Num c, Num d, Truthy d) => (a, (Float, Float, Float, b, c), d) -> (Char, b, Char) -> (a, (Float, Float, Float, b, c), d)
## The state after an event: a tick moves the clock and you, by every
## key held; a key going down or coming up (choose 2 CODE, choose 3
## CODE) is held or let go; a key event is one step.
l:s_tep := { (stage, r, held) e ->
  e sm:i_s "tick" ? (stage, ((r, held) h:a_ct 1) rc:t_ick f_irst sm:n_umbers e, held)
  (e sm:i_s "key") & 0 = '+ r_/ held ? (stage, r rc:k_ey sm:o_ld e, held)
  n_ot e sm:i_s "choose" ? (stage, r, held)
  n := f_loor sm:n_umbers e
  2 = f_irst n ? (stage, r, held h:h_old (2 s_elect n, 1))
  3 = f_irst n ? (stage, r, held h:h_old (2 s_elect n, 0))
  (stage, r, held)
}
# :: Any a => a -> Box Char
## The events it takes.
l:l_egal := { s -> "tick DT" "choose 2 CODE" "choose 3 CODE" "key w" "key s" "key a" "key d" "key up" "key down" "key left" "key right" }
# :: (Any a, Any b, Any c, Any d, Any e, Num f, Any g) => (a, (b, c, d, e, f), g) -> Int
## Won out of the door; playing until then.
l:s_tatus := { (_, r, _) -> 0 < rc:s_tatus r ? md:won; md:playing }
# :: (Any a, Num b, Num c, Num d, Any e) => (a, (Float, Float, b, c, d), e) -> (a, Box Char, Box Char, Float, Char)
## What to show: what the rays see.
l:v_iew := { (stage, r, _) -> vw:d_rawn (stage, rc:d_raw r, "The second maze. W S: walk, Left Right: turn, A D: sidestep. Find the door.") }
# :: (Any a, Any b, Any c, Any d, Any e, Num f, Any g) => (a, (b, c, d, e, f), g) -> (Int, (Box Char, Int), (Box Char, Int))
## Out of it: it is known walked, and it brings experience.
l:o_utcome := { s ->
  n_ot md:won = l:s_tatus s ? (md:left, md:nothing, md:nothing)
  (md:won, md:nothing md:s_et ("fact.passage-walked", 1), md:nothing md:s_et ("resource.xp", 20))
}
