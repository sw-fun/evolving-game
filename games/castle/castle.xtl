#!/usr/bin/env xetal
## The castle, scripted: the venues' list and what the world says of
## each; the map played on scripts of events (a place that is open is
## gone to, a locked one says what it needs, the key D shows them all);
## and a place not built yet, called done or left. The program that goes
## round them all is play.xtl.
"at:" u_se< "Atlas"
"dd:" u_se< "Deeds"
"dp:" u_se< "Depths"
"hd:" u_se< "Hoard"
"ov:" u_se< "Overture"
"ps:" u_se< "Passage"
"rm:" u_se< "Roaming"
"rc:" u_se< "Rays"
"wr:" u_se< "Warren"
"lg:" u_se< "Ledger"
"md:" u_se< "Mode"
"sk:" u_se< "Sketch"
"st:" u_se< "Strings"
"t:" u_se< "Text"
"vn:" u_se< "Venues"
"vw:" u_se< "View"
"w:" u_se< "World"
"wc:" u_se< "Warchest"

file := "castle.toml"
u:l_ast := { (_, s) -> s }
# The file is right for the map; how many venues; each one's kind and
# title.
t_ally at:mode md:p_roblem file
vn:c_ount file
_ := t:l_ines '{ k -> e_nclose (f_ormat k) c_at " " c_at (vn:k_ind (file, k)) c_at ": " c_at vn:t_itle (file, k) } e_ach r_ange vn:c_ount file
# A built venue's scenario is a path from here; a placeholder has none.
vn:s_cenario (file, 1)
t_ally vn:s_cenario (file, 4)
# What the world says of each venue (known, open, done, a row each): in
# an empty world two are known and open; with the first level won, what
# it leads to; with all three levels won and the bridge held, the
# crossing is open.
o_\ vn:s_tanding (file, md:nothing)
one := md:nothing md:s_et ("venue.bridge-1.done", 1)
o_\ vn:s_tanding (file, one)
held := (((one md:s_et ("venue.bridge-2.done", 1)) md:s_et ("venue.bridge-3.done", 1)) md:s_et ("fact.bridge-held", 1))
o_\ vn:s_tanding (file, held)

# The map in an empty world, shown: two places. The fourth is not known,
# so choosing it does nothing; the second is open, and is chosen.
u:m_ap := { (lines, world) -> u:l_ast 'at:v_iew 'at:l_egal 'at:s_tatus 'at:s_tep md:r_eplay (lines, at:n_ew (file, world, 1)) }
u:s_ay := { (status, changes, rewards) ->
  _ := p_rint! "outcome: " c_at md:s_tatusName status
  _ := t:l_ines '{ l -> e_nclose "  changes " c_at d_isclose l } e_ach md:l_ines changes
  t_ally t:l_ines '{ l -> e_nclose "  brings " c_at d_isclose l } e_ach md:l_ines rewards
}
_ := u:s_ay at:o_utcome u:m_ap ("choose 1 4" "choose 1 2", md:nothing)
# With the levels won but the bridge not held, the crossing is known and
# not open, and says what it needs; D shows and opens everything, and
# then it can be gone to.
unheld := ((one md:s_et ("venue.bridge-2.done", 1)) md:s_et ("venue.bridge-3.done", 1))
_ := u:s_ay at:o_utcome u:m_ap ("choose 1 9" "key D" "choose 1 9", unheld)
# What a player is given to draw for the map: a piece a venue known.
_ := t:l_ines '{ l -> e_nclose 70 t_ake d_isclose l } e_ach -3 t_ake st:l_ines vw:s_cene at:v_iew at:n_ew (file, one, 1)

# A place not built yet (the world is going to venue 10, the gate maze):
# what it will be; called done, it is won and brings a coin; left, it
# is left.
going := md:nothing md:s_et ("campaign.go", 10)
u:p_lace := { lines -> u:l_ast 'sk:v_iew 'sk:l_egal 'sk:s_tatus 'sk:s_tep md:r_eplay (lines, sk:n_ew (file, going, 1)) }
_ := u:s_ay sk:o_utcome u:p_lace "tick 1" "key space"
_ := u:s_ay sk:o_utcome u:p_lace 1 r_eshape e_nclose "key b"

# Deeds (quests and achievements): how many; which an empty world has
# earned (none); a world that has held the bridge in summer, with 160
# gold and 70 experience, earns the summer quest, First blood, A full
# purse, and, with the experience those bring, Veteran.
dd:c_ount file
dd:m_et (file, md:nothing)
earned := dd:a_ward (file, (((md:nothing md:s_et ("fact.bridge-held", 1)) md:s_et ("venue.bridge-1.done", 1)) md:s_et ("resource.gold", 160)) md:s_et ("resource.xp", 70))
_ := t:l_ines md:l_ines earned
# Quests done and in all, achievements earned and in all.
dd:t_ally (file, earned)
# Awarding again changes nothing but the count of new ones.
(md:l_ines dd:a_ward (file, earned)) m_atch md:l_ines earned md:s_et ("campaign.new", 0)
# The hall of deeds for that world: quests marked, achievements earned
# shown and the others hidden; a key leaves it, and it changes nothing.
u:h_all := { lines -> u:l_ast 'lg:v_iew 'lg:l_egal 'lg:s_tatus 'lg:s_tep md:r_eplay (lines, lg:n_ew (file, earned, 1)) }
_ := u:s_ay lg:o_utcome u:h_all "tick 1" "key b"
# The map then says the gold, the experience, and that there are new
# deeds.
vw:c_aption at:v_iew at:n_ew (file, earned, 1)

# Clicks. On the far end of a place's name ("2 The battlefield on
# foot" is written about picture point 124 195, and is some 150 wide):
# that place is chosen. On the hall's name: the hall. Within a tile of
# a place's marker: that place. On open country: none.
at:c_hosen u:m_ap (1 r_eshape e_nclose "click 190 195", md:nothing)
at:c_hosen u:m_ap (1 r_eshape e_nclose "click 30 165", md:nothing)
at:c_hosen u:m_ap (1 r_eshape e_nclose "click 124 233", md:nothing)
at:c_hosen u:m_ap (1 r_eshape e_nclose "click 400 60", md:nothing)

# The three games taken from X_eTaL-games, as modes of the castle. Each
# is entered, takes a few keys (its caption says how it stands), and,
# left before its way out is found, brings nothing.
_ := u:s_ay wr:o_utcome u:l_ast 'wr:v_iew 'wr:l_egal 'wr:s_tatus 'wr:s_tep md:r_eplay ("key w" "key d" "key up" "key m", wr:n_ew (file, md:nothing, 1))
_ := u:s_ay dp:o_utcome u:l_ast 'dp:v_iew 'dp:l_egal 'dp:s_tatus 'dp:s_tep md:r_eplay ("key d" "key down" "key q", dp:n_ew (file, md:nothing, 1))
_ := u:s_ay ps:o_utcome u:l_ast 'ps:v_iew 'ps:l_egal 'ps:s_tatus 'ps:s_tep md:r_eplay ("tick 0.05" "key w" "key right" "key w", ps:n_ew (file, md:nothing, 1))
# In the second maze a key held (the page's choose 2 CODE; 39 is the
# right arrow) turns you every tick until it is let go (choose 3 CODE):
# where you are and which way you face, after two ticks held and one
# more let go.
u:h_eld := u:l_ast 'ps:v_iew 'ps:l_egal 'ps:s_tatus 'ps:s_tep md:r_eplay ("choose 2 39" "tick 0.05" "tick 0.05" "choose 3 39" "tick 0.05", ps:n_ew (file, md:nothing, 1))
(_, rays, held, _) := u:h_eld
3 t_ake rc:y_ou rays
held

# The city inside the gate: the village is a maze of its houses. You
# start deep in it (the street farthest from the keep's door); holding
# W runs you into a house at once. The keep can be reached: from where
# you start it is so many steps (a solver, every street flooded from
# the keep's door), not the 999 of a street cut off.
u:c_ity := { lines -> u:l_ast 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep md:r_eplay (lines, rm:n_ew ("../walk/city.toml", md:nothing, 1)) }
rm:p_lace u:c_ity 1 r_eshape e_nclose "tick 0.0"
rm:p_lace u:c_ity (e_nclose "choose 2 87") c_at 4 r_eshape e_nclose "tick 0.5"
town := md:m_ap "../walk/city.toml"
ways := town w:d_istance (n_ot (w:t_iles town) m_ember? 2 5 6) & n_ot md:b_locked "../walk/city.toml"
here := rm:p_lace u:c_ity 1 r_eshape e_nclose "tick 0.0"
(2 s_elect here) s_elect (f_irst here) s_elect ways
# The winter camp can be won: W held eleven seconds walks the road from
# the south through the camp to the palisade's gate.
u:c_amp := { lines -> u:l_ast 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep md:r_eplay (lines, rm:n_ew ("../walk/camp.toml", md:nothing, 1)) }
_ := u:s_ay rm:o_utcome u:c_amp (e_nclose "choose 2 87") c_at 22 r_eshape e_nclose "tick 0.5"

# The long bridge opens with a card (the bridge painting): space goes
# on, B goes back; it brings nothing itself.
u:c_ard := { lines -> u:l_ast 'ov:v_iew 'ov:l_egal 'ov:s_tatus 'ov:s_tep md:r_eplay (lines, ov:n_ew (file, md:nothing md:s_et ("campaign.go", 9), 1)) }
_ := u:s_ay ov:o_utcome u:c_ard 1 r_eshape e_nclose "key space"
_ := u:s_ay ov:o_utcome u:c_ard 1 r_eshape e_nclose "key b"
# Then the walk across can be won: W held fifteen seconds takes you from
# the south bank over the bridge to the castle's gate.
u:a_cross := { lines -> u:l_ast 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep md:r_eplay (lines, rm:n_ew ("../walk/crossing.toml", md:nothing, 1)) }
_ := u:s_ay rm:o_utcome u:a_cross (e_nclose "choose 2 87") c_at 30 r_eshape e_nclose "tick 0.5"

# The road through the fields (venue 22, the approach the painting from
# the tower shows) opens with a card of that painting.
vw:c_aption ov:v_iew ov:n_ew (file, md:nothing md:s_et ("campaign.go", 22), 1)
# Then it can be won by following the road: out of the forest, W held
# along each stretch (ticks of a fifth of a second, so no field wall is
# stepped over) and an arrow held 0.9 seconds (a quarter turn) at each
# bend; the field walls stop you at the end of a stretch, and the gaps
# in them are where the road goes through, up to the town gate.
u:f_ields := { lines -> u:l_ast 'rm:l_egal 'rm:s_tatus 'rm:s_tep md:r_esult (lines, rm:n_ew ("../walk/fields.toml", md:nothing, 1)) }
u:s_tretch := { n -> (e_nclose "choose 2 87") c_at (n r_eshape e_nclose "tick 0.2") c_at e_nclose "choose 3 87" }
right := "choose 2 39" "tick 0.9" "choose 3 39"
left := "choose 2 37" "tick 0.9" "choose 3 37"
road := (u:s_tretch 16) c_at right c_at (u:s_tretch 28) c_at left c_at (u:s_tretch 12) c_at left c_at (u:s_tretch 20) c_at right c_at (u:s_tretch 12) c_at right c_at (u:s_tretch 10) c_at left c_at u:s_tretch 12
rm:p_lace u:f_ields u:s_tretch 16
vw:c_aption rm:v_iew u:f_ields road
_ := u:s_ay rm:o_utcome u:f_ields road

# The treasury (the idle game): ten seconds bring ten coins; a mint
# costs ten, after which coins come twice as fast; carried out, the
# coins are gold and the mint is kept. Five places won since the last
# visit, with that mint, leave 5 * 15 * 2 = 150 coins waiting.
u:h_oard := { (lines, world) -> u:l_ast 'hd:v_iew 'hd:l_egal 'hd:s_tatus 'hd:s_tep md:r_eplay (lines, hd:n_ew ("treasury.toml", world, 1)) }
_ := u:s_ay hd:o_utcome u:h_oard ("tick 5.0" "tick 5.0" "key 1" "tick 5.0" "key 1" "key space", md:nothing)
vw:c_aption hd:v_iew u:h_oard (1 r_eshape e_nclose "tick 0.0", (md:nothing md:s_et ("idle.1", 1)) md:s_et ("stat.won", 5))
# The ladder: a counting house cannot be bought before five mints (2
# does nothing); with five mints it opens, and bought it brings 8 coins
# a second more. A mint kept from before the ladder (idle.mints) counts.
rich := (md:nothing md:s_et ("idle.mints", 5)) md:s_et ("stat.won", 20)
vw:c_aption hd:v_iew u:h_oard (1 r_eshape e_nclose "key 2", (md:nothing md:s_et ("idle.1", 4)) md:s_et ("stat.won", 20))
vw:c_aption hd:v_iew u:h_oard (1 r_eshape e_nclose "key 2", rich)
# Struck by hand: C three times and a click bring four coins. Renown:
# with five deeds earned, the coins come a tenth faster (ten seconds
# with one mint: 2 * 1.1 * 10 = 22 coins).
vw:c_aption hd:v_iew u:h_oard ("key c" "key c" "key c" "click 400 300", md:nothing)
famed := (((((md:nothing md:s_et ("idle.1", 1)) md:s_et ("deed.cross", 1)) md:s_et ("deed.purse", 1)) md:s_et ("deed.veteran", 1)) md:s_et ("deed.way-in", 1)) md:s_et ("deed.first-win", 1)
vw:c_aption hd:v_iew u:h_oard (1 r_eshape e_nclose "tick 10.0", famed)
# Relics: the dungeon cleared (its hoard: things cost 9 in 10) and the
# bridge held (its toll: twice the coins waiting) make a first mint
# cost 9, and five places won leave 5 * 15 * 1 * 2 = 150 coins waiting.
found := ((md:nothing md:s_et ("fact.dungeon-cleared", 1)) md:s_et ("fact.bridge-held", 1)) md:s_et ("stat.won", 5)
hd:h_eld ("treasury.toml", found)
vw:c_aption hd:v_iew u:h_oard (1 r_eshape e_nclose "tick 0.0", found)

# The war chest (the attacker's idle game, Warchest.xtl, the camp's
# treasury): five seconds bring ten crowns; two raids by hand bring six;
# foragers cost fifteen and bring two crowns a second more; ten seconds
# then bring forty; the next foragers cost half as much again (22.5);
# carried out, the crowns are gold and the foragers are kept, under the
# chest's own names (chest.*, never the treasury's idle.*).
u:c_hest := { (lines, world) -> u:l_ast 'wc:v_iew 'wc:l_egal 'wc:s_tatus 'wc:s_tep md:r_eplay (lines, wc:n_ew ("warchest.toml", world, 1)) }
_ := u:s_ay wc:o_utcome u:c_hest ("tick 5.0" "key r" "key r" "key 1" "tick 10.0" "key 1" "key space", md:nothing)
# Up the ladder: a raiding party opens with five foragers; with twenty
# places won since the last visit, 20 * 10 * 12 = 2400 crowns wait, and
# one is bought (12 crowns a second more); the war council is not open.
camp := (md:nothing md:s_et ("chest.1", 5)) md:s_et ("stat.won", 20)
vw:c_aption wc:v_iew u:c_hest ("key 2" "key 5", camp)
# The war council opens with three mercenary companies; bought, it
# doubles everything (1622 crowns a second become 3244).
council := ((((camp md:s_et ("chest.2", 5)) md:s_et ("chest.3", 5)) md:s_et ("chest.4", 3)))
vw:c_aption wc:v_iew u:c_hest (1 r_eshape e_nclose "key 5", council)
# Raids by hand: R three times and a click bring twelve crowns; the
# treasury's C is not the chest's key.
vw:c_aption wc:v_iew u:c_hest ("key r" "key r" "key c" "key r" "click 400 300", md:nothing)
# War banners and trophies: five deeds raise five banners (the crowns
# come 15 in a hundred faster); the gate walked (its bar: things cost 85
# in a hundred) and the dungeon cleared (its chains: three times the
# crowns waiting), with four places won, leave 4 * 10 * 2.3 * 3 = 276
# crowns waiting, and the first foragers cost 12.
taken := ((famed md:s_et ("fact.walked-in", 1)) md:s_et ("fact.dungeon-cleared", 1)) md:s_et ("stat.won", 4)
wc:h_eld ("warchest.toml", taken)
vw:c_aption wc:v_iew u:c_hest (1 r_eshape e_nclose "tick 0.0", taken)
# Carried out, the chest marks the places won so far seen (chest.seen),
# so they fill it only once.
_ := u:s_ay wc:o_utcome u:c_hest (1 r_eshape e_nclose "key space", md:nothing md:s_et ("stat.won", 3))
# Both idle games' gold is the world's: a world with 7 gold, after the
# treasury's 10 coins and the war chest's 10 crowns are carried out,
# holds 27, the gold the next level of Castle Defense starts with; the
# two keep what they own under their own names.
purse := md:nothing md:s_et ("resource.gold", 7)
after := purse md:a_fter hd:o_utcome u:h_oard (("tick 10.0" "key space"), purse)
both := after md:a_fter wc:o_utcome u:c_hest (("tick 5.0" "key space"), after)
both md:g_et "resource.gold"
_ := t:l_ines md:l_ines both
