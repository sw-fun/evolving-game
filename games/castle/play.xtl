#!/usr/bin/env xetal
## The castle: every game, level and place of Evolving Game, and the way
## from one to the next. The map of the castle and its country shows the
## places you have found; a click on one (or "choose 1 N" for the venue
## numbered N) goes there; when its game ends you are back at the map,
## and what you won is in the world: the gold kept at the bridge is the
## next level's to spend, a bridge held opens the crossing, and a place
## won shows where it leads. Winning brings experience, and deeds
## (quests and achievements) are awarded as they are earned: the hall
## of deeds shows them. The key D on the map shows and opens every
## place. A place whose game is not built yet says what it will be, and
## can be called done. The command "choose 0 0" leaves a game as it
## stands and goes back to the map. The events come from the host, as every game's
## do; when they end, the world as it then stands is printed. In a
## browser the world is kept between visits. The
## venues are castle.toml's; each game is its own mode, played by
## lib/Mode's loop.
"ak:" u_se< "Attacking"
"at:" u_se< "Atlas"
"dd:" u_se< "Deeds"
"df:" u_se< "Defending"
"dp:" u_se< "Depths"
"fr:" u_se< "Front"
"hd:" u_se< "Hoard"
"lg:" u_se< "Ledger"
"ov:" u_se< "Overture"
"ps:" u_se< "Passage"
"rd:" u_se< "Roads"
"wr:" u_se< "Warren"
"wc:" u_se< "Warchest"
"md:" u_se< "Mode"
"mu:" u_se< "Music"
"rm:" u_se< "Roaming"
"sk:" u_se< "Sketch"
"sp:" u_se< "Splash"
"sm:" u_se< "Sim"
"t:" u_se< "Text"
"tk:" u_se< "Talk"
"vn:" u_se< "Venues"

file := "castle.toml"
## The music (music.toml, lib/Music): every mode is played with its
## place's set (a new plan of a set after every place won) and the
## world whose settings say how loud; every picture has the sound's
## strip (lib/Mode), and what it changed comes back with the outcome,
## kept in the world as settings.music and settings.mute. Coming from
## a place of another set (music.came, the venue left, and
## music.ended, how it ended: set when a venue ends, cleared when the
## next place is chosen), the music changes fast through a bridge.
music := "music.toml"
## The kind of the venue the music comes from: the one left
## (music.came), or the map's.
u:c_ame := { world ->
  k := world md:g_et "music.came"
  k < 1 ? "roads"
  vn:k_ind (file, k)
}
## A world whose music no longer comes from a venue left.
u:c_alm := { world -> (world md:s_et ("music.came", 0)) md:s_et ("music.ended", 0) }
## An outcome with what the sound's strip changed: the outcome's own
## changes, then the strip's.
u:a_lso := { heard (status, changes, rewards) -> (status, changes md:m_erge heard, rewards) }
## A mode's outcome from what mu:p_lay gives (heard, last state).
u:h_eard := { outcome_ (heard, s) -> heard u:a_lso outcome_ s }
## The profile a save's home is (front.home.NAME), or "".
u:h_omeName := { save ->
  (names, _) := save
  is := '{ x -> "front.home." m_atch 11 t_ake (d_isclose x) c_at "           " } e_ach names
  0 = '+ r_/ is ? ""
  11 d_rop d_isclose f_irst is r_eplicate names
}
## The world of the profile a save's home is, or nothing: whose
## settings the splash and the front door play by.
u:p_rofile := { save ->
  name := u:h_omeName save
  0 = t_ally name ? md:nothing
  save fr:o_ut name
}
## A save with what the strip changed put in its home profile's world.
u:i_nto := { save heard ->
  name := u:h_omeName save
  0 = t_ally name ? save
  (names, values) := heard
  save md:m_erge ('{ x -> e_nclose "p." c_at name c_at "." c_at d_isclose x } e_ach names, values)
}
## In a browser the world is kept between visits: written after every
## game and read at the start, as the text "castle.save" in the host's
## store. At the command line nothing is kept, so a run is only what
## its events make it.
web := @ c_fg< "web"
u:k_ept := { @ ->
  n_ot web ? md:nothing
  md:f_rom '{ @ -> []N_GET "castle.save" } []T_RAP '{ err -> []R_ECOVER "" }
}
u:k_eep := { world ->
  n_ot web ? world
  _ := (md:t_ext (fr:m_igrate u:k_ept @, u:n_ame world) fr:i_n world) []N_PUT "castle.save"
  world
}
## The profile a world is (its front.name.NAME), "player" if none.
u:n_ame := { (names, values) ->
  is := '{ x -> "front.name." m_atch 11 t_ake (d_isclose x) c_at "           " } e_ach names
  0 = '+ r_/ is ? "player"
  11 d_rop d_isclose f_irst is r_eplicate names
}
## The place being played, for the page's debug panel: the venue's
## name (castle.toml) while one is played, or "" on the menus (the
## splash, the front door, the road, the map).
u:p_lace := { (kind, world) ->
  (names, _) := world
  menus := "splash" "front" "roads" "atlas"
  (menus i_ndexOf e_nclose kind) <= t_ally menus ? ""
  (names i_ndexOf e_nclose "campaign.go") > t_ally names ? ""
  d_isclose (world md:g_et "campaign.go") s_elect vn:n_ames file
}
## The music for a kind of place in a world, and what the page's debug
## panel shows of it: status('KIND', 'PLACE', 'PROFILE').
u:t_une := { (kind, world) ->
  said := "status('" c_at kind c_at "', '" c_at (u:p_lace (kind, world)) c_at "', '" c_at (u:n_ame world) c_at "')\n"
  ((mu:l_ine (music, kind, world md:g_et "stat.won", (u:c_ame world, world md:g_et "music.ended"))) c_at said, world)
}
## The front door (who plays, their character, what to play), over the
## whole save; then what was chosen: the castle's map, the hall of
## deeds, or the treasury, and back to the profile's home after; or
## starting over, this profile's winnings forgotten (its character and
## settings kept, every other profile as it was), and home again. The
## events ended, the profile's world as it stands.
u:d_oor := { save -> u:e_nter (save, fr:n_ew ("front.toml", save, 1)) }
## The front door played from a state of it (new, or new with an event
## already taken).
u:e_nter := { (save, start) ->
  (heard, ended) := (u:t_une ("front", u:p_rofile save)) 'fr:o_utcome 'fr:v_iew 'fr:l_egal 'fr:s_tatus 'fr:s_tep mu:p_lay start
  (status, picks, _) := fr:o_utcome ended
  n_ot status = md:won ? u:a_gain save u:i_nto heard
  name := u:n_ame picks
  world := u:c_alm u:k_eep (save fr:o_ut name) md:m_erge picks md:m_erge heard
  go := world md:g_et "front.go"
  go = 2 ? u:t_hen (world, 17)
  go = 3 ? u:t_hen (world, 15)
  go = 4 ? u:h_ome u:k_eep fr:o_ver world
  u:r_ound world
}
## A venue gone to from home (the hall of deeds, 17, or the treasury,
## 15), then home again.
u:t_hen := { (world, k) -> u:h_ome u:k_eep (world, k) u:a_fter u:v_isit (world, k) }
## The front door again, at the profile's home (straight away: the
## front door itself ends the game when the events have ended).
u:h_ome := { world -> u:d_oor (fr:m_igrate u:k_ept @) md:s_et ("front.home." c_at u:n_ame world, 1) }
## The front door left (Esc): again from the start, unless the events
## have ended.
u:a_gain := { save ->
  e := sm:n_ext @
  e sm:i_s "end" ? save
  u:e_nter (save, (fr:n_ew ("front.toml", save, 1)) u:t_aken e)
}
## A new front door with the event read to see whether the events had
## ended: taken as the door would take it, so it is not lost (a key
## pressed just after leaving).
u:t_aken := { s e ->
  n_ot (fr:l_egal s) md:a_llows e ? s
  s fr:s_tep e
}
## The treasury: its outcome, and the places won so far marked seen
## (the outcome cannot know them; idle.seen is reset to them here).
u:h_oard := { (world, k, path) ->
  (status, changes, rewards) := 'hd:o_utcome u:h_eard (u:t_une ("idle", world)) 'hd:o_utcome 'hd:v_iew 'hd:l_egal 'hd:s_tatus 'hd:s_tep mu:p_lay hd:n_ew (path, world, k)
  (status, changes md:s_et ("idle.seen", (world md:g_et "stat.won")), rewards)
}
## A place on foot whose scenario names a painting: its card, and then,
## gone on from it, the walk; left at the card, nothing happens.
u:c_ross := { (world, k, path) ->
  (heard, card) := (u:t_une ("roam", world)) 'ov:o_utcome 'ov:v_iew 'ov:l_egal 'ov:s_tatus 'ov:s_tep mu:p_lay ov:n_ew (file, world, k)
  n_ot md:won = ov:s_tatus card ? (md:left, heard, md:nothing)
  there := world md:m_erge heard
  heard u:a_lso 'rm:o_utcome u:h_eard (u:t_une ("roam", there)) 'rm:o_utcome 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep mu:p_lay rm:n_ew (path, there, k)
}
## The dungeon, its card first when its scenario names a painting;
## left at the card, nothing happens.
u:d_own := { (world, k, path) ->
  0 = t_ally ov:a_rt path ? 'dp:o_utcome u:h_eard (u:t_une ("dungeon", world)) 'dp:o_utcome 'dp:v_iew 'dp:l_egal 'dp:s_tatus 'dp:s_tep mu:p_lay dp:n_ew (file, world, k)
  (heard, card) := (u:t_une ("dungeon", world)) 'ov:o_utcome 'ov:v_iew 'ov:l_egal 'ov:s_tatus 'ov:s_tep mu:p_lay ov:n_ew (file, world, k)
  n_ot md:won = ov:s_tatus card ? (md:left, heard, md:nothing)
  there := world md:m_erge heard
  heard u:a_lso 'dp:o_utcome u:h_eard (u:t_une ("dungeon", there)) 'dp:o_utcome 'dp:v_iew 'dp:l_egal 'dp:s_tatus 'dp:s_tep mu:p_lay dp:n_ew (file, there, k)
}
## A venue played to its end in a world: its mode chosen by its kind;
## every mode's outcome is the same kind of thing.
u:v_isit := { (world, k) ->
  kind := vn:k_ind (file, k)
  tune := u:t_une (kind, world)
  path := vn:s_cenario (file, k)
  kind m_atch "defense" ? 'df:o_utcome u:h_eard tune 'df:o_utcome 'df:v_iew 'df:l_egal 'df:s_tatus 'df:s_tep mu:p_lay df:n_ew (path, world, k)
  kind m_atch "attack" ? 'ak:o_utcome u:h_eard tune 'ak:o_utcome 'ak:v_iew 'ak:l_egal 'ak:s_tatus 'ak:s_tep mu:p_lay ak:n_ew (path, world, k)
  (kind m_atch "roam") & 0 < t_ally ov:a_rt path ? u:c_ross (world, k, path)
  kind m_atch "roam" ? 'rm:o_utcome u:h_eard tune 'rm:o_utcome 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep mu:p_lay rm:n_ew (path, world, k)
  kind m_atch "maze" ? 'wr:o_utcome u:h_eard tune 'wr:o_utcome 'wr:v_iew 'wr:l_egal 'wr:s_tatus 'wr:s_tep mu:p_lay wr:n_ew (file, world, k)
  kind m_atch "dungeon" ? u:d_own (world, k, path)
  kind m_atch "raycaster" ? 'ps:o_utcome u:h_eard tune 'ps:o_utcome 'ps:v_iew 'ps:l_egal 'ps:s_tatus 'ps:s_tep mu:p_lay ps:n_ew (file, world, k)
  kind m_atch "idle" ? u:h_oard (world, k, path)
  kind m_atch "chest" ? 'wc:o_utcome u:h_eard tune 'wc:o_utcome 'wc:v_iew 'wc:l_egal 'wc:s_tatus 'wc:s_tep mu:p_lay wc:n_ew (path, world, k)
  kind m_atch "talk" ? 'tk:o_utcome u:h_eard tune 'tk:o_utcome 'tk:v_iew 'tk:l_egal 'tk:s_tatus 'tk:s_tep mu:p_lay tk:n_ew (path, world, k)
  kind m_atch "board" ? 'lg:o_utcome u:h_eard tune 'lg:o_utcome 'lg:v_iew 'lg:l_egal 'lg:s_tatus 'lg:s_tep mu:p_lay lg:n_ew (file, world, k)
  'sk:o_utcome u:h_eard tune 'sk:o_utcome 'sk:v_iew 'sk:l_egal 'sk:s_tatus 'sk:s_tep mu:p_lay sk:n_ew (file, world, k)
}
## The world after a venue's outcome: what it changed and brought; won,
## the venue marked done and counted (stat.won); and every deed it has
## now earned awarded (Deeds.xtl).
u:a_fter := { (world, k) outcome ->
  (status, _, _) := outcome
  next := world md:a_fter outcome
  n_ot status = md:won ? dd:a_ward (file, next)
  done := next md:s_et (vn:d_one (file, k), 1)
  dd:a_ward (file, done md:s_et ("stat.won", '+ r_/ 3 s_elect_2 vn:s_tanding (file, done)))
}
## The map, then the venue chosen, then the map again, until the events
## end.
u:r_ound := { world ->
  chose := u:c_hoose world
  (status, going, _) := chose
  n_ot status = md:won ? u:s_tay (u:k_eep (world md:m_erge going) md:s_et ("menu.go", 0), going md:g_et "menu.go")
  k := going md:g_et "campaign.go"
  there := u:c_alm world md:m_erge going
  (there, k) u:o_n u:v_isit (there, k)
}
## After a venue: its outcome taken into the world and kept; then the
## map again, or the profile's home when the settings panel (lib/Mode)
## exited to the start menu (menu.go 1, not kept).
u:o_n := { (world, k) outcome ->
  (status, changes, _) := outcome
  after := u:k_eep ((((world, k) u:a_fter outcome) md:s_et ("menu.go", 0)) md:s_et ("music.came", k)) md:s_et ("music.ended", status)
  1 = changes md:g_et "menu.go" ? u:h_ome after
  u:r_ound after
}
## Where the next place is chosen: the side's road of levels (Roads.xtl),
## or, for the profile named debug, the map of every venue (Atlas.xtl).
u:c_hoose := { world ->
  "debug" m_atch u:n_ame world ? 'at:o_utcome u:h_eard (u:t_une ("atlas", world)) 'at:o_utcome 'at:v_iew 'at:l_egal 'at:s_tatus 'at:s_tep mu:p_lay at:n_ew (file, world, 1)
  'rd:o_utcome u:h_eard (u:t_une ("roads", world)) 'rd:o_utcome 'rd:v_iew 'rd:l_egal 'rd:s_tatus 'rd:s_tep mu:p_lay rd:n_ew ("levels.toml", world, 1)
}
## The map was left without a place chosen: the events have ended (the
## next is the end again), and so does the game; or it was the command
## to leave (Esc), which goes back to the profile's home; or the menu
## bar sent it (menu.go): 2 the hall of deeds, 3 the profile's
## settings, 4 the profiles.
u:s_tay := { (world, menu) ->
  menu = 2 ? u:t_hen (world, 17)
  menu = 3 ? u:d_oor (fr:m_igrate u:k_ept @) md:s_et ("front.home." c_at u:n_ame world, 2)
  menu = 4 ? u:d_oor fr:m_igrate u:k_ept @
  u:h_ome world
}
wrong := at:mode md:p_roblem file
_ := t:l_ines (0 < t_ally wrong) r_eplicate e_nclose wrong
## The splash first, then the map.
(splashed, _) := (u:t_une ("splash", u:p_rofile fr:m_igrate u:k_ept @)) 'sp:o_utcome 'sp:v_iew 'sp:l_egal 'sp:s_tatus 'sp:s_tep mu:p_lay sp:n_ew (file, md:nothing, 1)
_ := t:l_ines md:l_ines u:d_oor (fr:m_igrate u:k_ept @) u:i_nto splashed
