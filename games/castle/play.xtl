#!/usr/bin/env xetal
## The castle: every game, level and place of Evolving Game, and the way
## from one to the next. The map of the castle and its country shows the
## places you have found; a click on one (or "choose 1 N" for the venue
## numbered N) goes there; when its game ends you are back at the map,
## and what you won is in the world: the gold kept at the bridge is the
## next level's to spend, a bridge held opens the crossing, and a place
## won shows where it leads. Winning brings experience, and deeds
## (quests and achievements) are awarded as they are earned: the hall
## of deeds shows them. The key D on the map shows and opens every
## place. A place whose game is not built yet says what it will be, and
## can be called done. The command "choose 0 0" leaves a game as it
## stands and goes back to the map. The events come from the host, as every game's
## do; when they end, the world as it then stands is printed. In a
## browser the world is kept between visits. The
## venues are castle.toml's; each game is its own mode, played by
## lib/Mode's loop.
"at:" u_se< "Atlas"
"dd:" u_se< "Deeds"
"df:" u_se< "Defending"
"dp:" u_se< "Depths"
"lg:" u_se< "Ledger"
"ps:" u_se< "Passage"
"wr:" u_se< "Warren"
"md:" u_se< "Mode"
"rm:" u_se< "Roaming"
"sk:" u_se< "Sketch"
"sm:" u_se< "Sim"
"t:" u_se< "Text"
"vn:" u_se< "Venues"

file := "castle.toml"
## In a browser the world is kept between visits: written after every
## game and read at the start, as the text "castle.save" in the host's
## store. At the command line nothing is kept, so a run is only what
## its events make it.
web := @ c_fg< "web"
u:k_ept := { @ ->
  n_ot web ? md:nothing
  md:f_rom '{ @ -> []N_GET "castle.save" } []T_RAP '{ err -> []R_ECOVER "" }
}
u:k_eep := { world ->
  n_ot web ? world
  _ := (md:t_ext world) []N_PUT "castle.save"
  world
}
u:l_ast := { (_, s) -> s }
## A venue played to its end in a world: its mode chosen by its kind;
## every mode's outcome is the same kind of thing.
u:v_isit := { (world, k) ->
  kind := vn:k_ind (file, k)
  path := vn:s_cenario (file, k)
  kind m_atch "defense" ? df:o_utcome u:l_ast 'df:v_iew 'df:l_egal 'df:s_tatus 'df:s_tep md:p_lay df:n_ew (path, world, k)
  kind m_atch "roam" ? rm:o_utcome u:l_ast 'rm:v_iew 'rm:l_egal 'rm:s_tatus 'rm:s_tep md:p_lay rm:n_ew (path, world, k)
  kind m_atch "maze" ? wr:o_utcome u:l_ast 'wr:v_iew 'wr:l_egal 'wr:s_tatus 'wr:s_tep md:p_lay wr:n_ew (file, world, k)
  kind m_atch "dungeon" ? dp:o_utcome u:l_ast 'dp:v_iew 'dp:l_egal 'dp:s_tatus 'dp:s_tep md:p_lay dp:n_ew (file, world, k)
  kind m_atch "raycaster" ? ps:o_utcome u:l_ast 'ps:v_iew 'ps:l_egal 'ps:s_tatus 'ps:s_tep md:p_lay ps:n_ew (file, world, k)
  kind m_atch "board" ? lg:o_utcome u:l_ast 'lg:v_iew 'lg:l_egal 'lg:s_tatus 'lg:s_tep md:p_lay lg:n_ew (file, world, k)
  sk:o_utcome u:l_ast 'sk:v_iew 'sk:l_egal 'sk:s_tatus 'sk:s_tep md:p_lay sk:n_ew (file, world, k)
}
## The world after a venue's outcome: what it changed and brought; won,
## the venue marked done and counted (stat.won); and every deed it has
## now earned awarded (Deeds.xtl).
u:a_fter := { (world, k) outcome ->
  (status, _, _) := outcome
  next := world md:a_fter outcome
  n_ot status = md:won ? dd:a_ward (file, next)
  done := next md:s_et (vn:d_one (file, k), 1)
  dd:a_ward (file, done md:s_et ("stat.won", '+ r_/ 3 s_elect_2 vn:s_tanding (file, done)))
}
## The map, then the venue chosen, then the map again, until the events
## end.
u:r_ound := { world ->
  chose := at:o_utcome u:l_ast 'at:v_iew 'at:l_egal 'at:s_tatus 'at:s_tep md:p_lay at:n_ew (file, world, 1)
  (status, going, _) := chose
  n_ot status = md:won ? u:s_tay world
  k := going md:g_et "campaign.go"
  there := world md:m_erge going
  u:r_ound u:k_eep (there, k) u:a_fter u:v_isit (there, k)
}
## The map was left without a place chosen: the events have ended (the
## next is the end again), and so does the game; or it was the command
## to leave, which at the map goes nowhere, and the map is shown again.
u:s_tay := { world ->
  (sm:n_ext @) sm:i_s "end" ? world
  u:r_ound world
}
wrong := at:mode md:p_roblem file
_ := t:l_ines (0 < t_ally wrong) r_eplicate e_nclose wrong
_ := t:l_ines md:l_ines u:r_ound u:k_ept @
