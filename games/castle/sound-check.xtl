#!/usr/bin/env xetal
## The front door's Settings and the sound strip are one sound, at once
## (lib/Mode's loop): a change in Settings is the loop's sound after
## that very event (the next picture plays at that volume), muting is
## silence at once, and the strip's keys show in Settings' rows. What
## the loop heard comes back as the world's settings.
"fr:" u_se< "Front"
"md:" u_se< "Mode"
"t:" u_se< "Text"

file := "front.toml"
## A save with one profile, ann, her music never set (6 of 10).
ann := (md:nothing md:s_et ("p.ann.profile", 1)) md:s_et ("p.ann.character.calling", 1)
## The front door played on a script, as the castle plays it: what the
## loop heard (the world's settings) and the last state. The pictures'
## text is printed as it changes.
u:h_ear := { lines -> 'fr:o_utcome 'fr:v_iew 'fr:l_egal 'fr:s_tatus 'fr:s_tep md:r_eplayHeard ("", md:nothing, lines, fr:n_ew (file, ann, 1)) }
## The loudness a picture would carry after a script: volume(V).
u:l_oud := { lines ->
  (heard, _) := u:h_ear lines
  sound := md:s_ound heard
  "volume(" c_at (f_ormat md:v_olume sound) c_at ")"
}
## Settings' music rows after a script.
u:r_ows := { lines ->
  (_, last) := u:h_ear lines
  rows := fr:l_ines last
  (d_isclose 5 s_elect rows) c_at " / " c_at d_isclose 6 s_elect rows
}
# Ann, then Settings, then down to the music's volume: 6 of 10.
to := "key 1" "key 4" "key DOWN" "key DOWN" "key DOWN" "key DOWN"
u:l_oud to
# Left three times: after the first the loudness is 0.5, after the
# third 0.3: each the very event that changed the row.
u:l_oud to c_at e_nclose "key LEFT"
u:l_oud to c_at "key LEFT" "key LEFT" "key LEFT"
# Muted (Down to its row, Right): silence at once; on again, 0.3.
u:l_oud to c_at "key LEFT" "key LEFT" "key LEFT" "key DOWN" "key RIGHT"
u:l_oud to c_at "key LEFT" "key LEFT" "key LEFT" "key DOWN" "key RIGHT" "key RIGHT"
# The strip's keys in Settings: ] is louder and M mutes, and Settings'
# rows say so.
u:r_ows "key 1" "key 4"
u:r_ows "key 1" "key 4" "key ]" "key ]"
u:r_ows "key 1" "key 4" "key ]" "key m"
# What comes back: Settings' change and the strip's together, kept.
(heard, _) := u:h_ear to c_at "key LEFT" "key LEFT" "key ]"
_ := t:l_ines md:l_ines heard
