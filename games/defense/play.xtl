#!/usr/bin/env xetal
## Castle Defense: Defend the Bridge. Enemies come up the road in waves,
## over the bridge, to the castle gate; build towers on the grass to
## stop them. 1, 2 and 3 choose the archer, fire or ice tower; a click
## on grass builds it there if you have the gold; the space bar sends
## the next wave. The events come from the host: on a page, the clock's
## ticks, your keys and clicks; at the command line, lines on standard
## input such as "tick 0.05", "key 2", "choose 15 5" (build on row 15,
## column 5) and "key space". The rules are Defending.xtl's, played by
## lib/Mode's loop.
"df:" u_se< "Defending"
"md:" u_se< "Mode"
"t:" u_se< "Text"

u:s_ay := { outcome ->
  (status, _, _) := outcome
  _ := p_rint! "The level was " c_at (md:s_tatusName status) c_at "."
  t_ally t:l_ines md:l_ines md:nothing md:a_fter outcome
}
u:p_lay := { file ->
  wrong := df:mode md:p_roblem file
  0 < t_ally wrong ? t_ally t:l_ines e_nclose wrong
  (_, state) := 'df:v_iew 'df:l_egal 'df:s_tatus 'df:s_tep md:p_lay df:n_ew (file, md:nothing, 1)
  u:s_ay df:o_utcome state
}
_ := u:p_lay "defend.toml"
