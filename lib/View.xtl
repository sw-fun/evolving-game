## View: what a mode shows, in three forms from one value (docs/plan.md
## D7): a drawing in text (the terminal, the goldens), a flat picture
## (SVG, an isometric view: always there, the fallback where there is no
## 3D), and a scene (the calls of a 3D player: the camera that sees the
## board exactly as the picture does, the tiles, and each piece's model,
## place, heading, clip and time, and where it is going). A mode never
## writes SVG or a scene: it says what is where, and this library draws.
##
## A stage is a map made ready to draw, once: (map, numbers, tiles,
## depths, ground, smooth): the picture's numbers, the tiles' SVG far
## to near, joined a band at a time (every tile of one depth, the
## board's diagonal row + column, in one text: a tick then joins a band
## a diagonal, not a text a tile), each band's depth, the scene's
## ground, and whether that is one smooth surface (vw:s_mooth) or the
## tiles (vw:s_tage). A mode keeps its stage.
## A view is (stage, models, clips, pieces, caption): a model name and a
## clip name a piece, and a row of numbers a piece:
##   x y     where it is on the board: x east and y south, in tiles from
##           the map's north-west corner, so tile (row r, column c) has
##           its middle at x = c - 0.5, y = r - 0.5
##   hx hy   the way it faces
##   t       how far into its clip it is, in seconds
##   x2 y2   where it will be dt seconds from now (the player moves it
##   dt      there between ticks; the same place for one standing)
## A piece stands on the tile under it, at that tile's elevation.
##
## The picture's map: a board point (x, y, height) is drawn at
##   px = ox + tw * (x - y),  py = oy + th * (x + y) - zh * height
## and a click goes back through its inverse to the nearest tile whose
## top is under it.
## Import: "vw:" u_se< "View"

"t:" u_se< "Text"
"sk:" u_se< "Sky"
"st:" u_se< "Strings"
"tr:" u_se< "Terrain"
"w:" u_se< "World"

### The picture's numbers

## Half a tile's width and height in the picture, and the rise of one
## step of elevation (half a tile's width of the world, seen from 30
## degrees up).
h:tw := 20.0
h:th := 10.0
h:zh := 0.5 * 20.0 * 0.8660254 * 2.0 ^ 0.5
h:edge := 24.0
## A map's picture: ox, oy (where the board's north-west corner is
## drawn), width and height.
h:f_rame := { map ->
  rc := f_loat w:s_ize map
  up := h:zh * f_loat 'm_ax r_/ r_avel w:h_eights map
  (h:edge + h:tw * f_irst rc) c_at (h:edge + up) c_at ((2.0 * h:edge) + h:tw * '+ r_/ rc) c_at (2.0 * h:edge) + up + 30.0 + h:th * '+ r_/ rc
}
## Numbers for a picture: whole; for a scene: to a thousandth.
h:w_hole := { v -> f_loor 0.5 + v }
h:f_ine := { v -> (f_loat f_loor 0.5 + 1000.0 * v) / 1000.0 }

### The map and its inverse

h:t_o := { frame p ->
  x := f_irst_2 p
  y := 2 s_elect_2 p
  z := 3 s_elect_2 p
  o_\ (2 c_at t_ally x) r_eshape ((f_irst frame) + h:tw * x - y) c_at ((2 s_elect frame) + h:th * x + y) - h:zh * z
}
# :: (Any a, Any b, Any c, Any d, Any e) => (a, Float, b, c, d, e) -> Float -> Float
## Where board points are drawn: stage vw:t_o points, a row a point (x,
## y, height in steps), giving a row a point (px, py).
l:t_o := { (_, frame, _, _, _, _) p -> frame h:t_o p }
# :: (Any a, Any b, Any c, Any d, Any e) => (a, Float, b, c, d, e) -> Float -> Float
## The board point a picture point shows at a height: stage vw:b_ack
## (px, py, height), giving (x, y). The inverse of t_o.
l:b_ack := { (_, frame, _, _, _, _) p ->
  a := ((f_irst p) - f_irst frame) / h:tw
  b := (((2 s_elect p) - 2 s_elect frame) + h:zh * 3 s_elect p) / h:th
  (0.5 * a + b) c_at 0.5 * b - a
}
# :: (Any a, Num b, Any c, Any d, Any e, Num f) => ((a, Int, b), Float, c, d, e, f) -> Float -> Int
## The tile under a picture point: stage vw:t_ile (px, py), a place (row,
## column), or 0 0 off the board. Every tile is asked at once whether
## its top, at its own elevation, is under the point; of those that are,
## the nearest to the eye wins (it hides the others). On a smooth
## stage the surface itself is asked, to a third of a tile.
l:t_ile := { (map, frame, _, _, _, smooth) p ->
  smooth = 1 ? (map, frame) h:o_nSurface p
  heights := f_loat r_avel w:h_eights map
  rc := w:s_ize map
  n := t_ally heights
  rows := 1 + ((r_ange n) - 1) d_iv 2 s_elect rc
  cols := 1 + ((r_ange n) - 1) m_od 2 s_elect rc
  a := ((f_irst p) - f_irst frame) / h:tw
  b := (((2 s_elect p) - 2 s_elect frame) + h:zh * heights) / h:th
  under := (cols = 1 + f_loor 0.5 * a + b) & rows = 1 + f_loor 0.5 * b - a
  0 = '+ r_/ under ? 0 0
  near := under * rows + cols
  i := f_irst w_here near = 'm_ax r_/ near
  (i s_elect rows) c_at i s_elect cols
}
## The tile under a picture point on a smooth stage, where a tile is
## not flat at its own elevation: nine points of every tile's surface
## (thirds of a tile apart) are drawn, and of those within reach of the
## click (7 units of the picture) the nearest to the eye wins. 0 0 when
## none is.
h:o_nSurface := { (map, frame) p ->
  rc := w:s_ize map
  n := 9 * '* r_/ rc
  i := (r_ange n) - 1
  tile := i d_iv 9
  x := (f_loat tile m_od 2 s_elect rc) + (1.0 + 2.0 * f_loat (i m_od 9) m_od 3) / 6.0
  y := (f_loat tile d_iv 2 s_elect rc) + (1.0 + 2.0 * f_loat (i m_od 9) d_iv 3) / 6.0
  xy := o_\ (2 c_at n) r_eshape x c_at y
  at := frame h:t_o xy c_at_2 (n c_at 1) r_eshape 2.0 * map tr:s_tand xy
  dx := (f_irst_2 at) - f_irst p
  dy := (2 s_elect_2 at) - 2 s_elect p
  near := 49.0 >= (dx * dx) + dy * dy
  0 = '+ r_/ near ? 0 0
  depth := (f_loat near) * 1.0 + x + y
  k := (f_irst w_here depth = 'm_ax r_/ depth) s_elect tile
  (1 + k d_iv 2 s_elect rc) c_at 1 + k m_od 2 s_elect rc
}
## The elevation under board points (x, y a row), 0 off the board.
h:u_nder := { map xy ->
  heights := w:h_eights map
  rc := w:s_ize map
  r := 1 + f_loor 2 s_elect_2 xy
  c := 1 + f_loor f_irst_2 xy
  inside := (r >= 1) & (c >= 1) & (r <= f_irst rc) & c <= 2 s_elect rc
  i := (1 m_ax c m_in 2 s_elect rc) + (2 s_elect rc) * (1 m_ax r m_in f_irst rc) - 1
  f_loat inside * i s_elect r_avel heights
}

### A stage

h:tops := "#5f9550" "#3f7fbf" "#9c7a4d" "#b9a37a" "#9aa0aa" "#7b8072" "#5b4630" "#c9b27f"
h:lefts := "#4b773f" "#326699" "#7c613d" "#948261" "#7b8088" "#62665b" "#483826" "#a08e65"
h:rights := "#3a5c31" "#274f77" "#604b2f" "#73654b" "#5f636a" "#4c4f46" "#382b1d" "#7c6e4e"
h:p_oly := { fill pts -> "<polygon points=\"" c_at (f_ormat h:w_hole r_avel pts) c_at "\" fill=\"" c_at fill c_at "\"/>" }
## One tile's SVG: its top, and its two sides toward the eye when it
## stands above the ground.
h:t_ileSvg := { frame (r, c, kind, z) ->
  x := f_loat c
  y := f_loat r
  top := frame h:t_o 4 3 r_eshape (x - 1.0) c_at (y - 1.0) c_at z c_at x c_at (y - 1.0) c_at z c_at x c_at y c_at z c_at (x - 1.0) c_at y c_at z
  face := (d_isclose kind s_elect h:tops) h:p_oly top
  z <= 0.0 ? face
  left := frame h:t_o 4 3 r_eshape (x - 1.0) c_at y c_at z c_at x c_at y c_at z c_at x c_at y c_at 0.0 c_at (x - 1.0) c_at y c_at 0.0
  right := frame h:t_o 4 3 r_eshape x c_at (y - 1.0) c_at z c_at x c_at y c_at z c_at x c_at y c_at 0.0 c_at x c_at (y - 1.0) c_at 0.0
  ((d_isclose kind s_elect h:lefts) h:p_oly left) c_at ((d_isclose kind s_elect h:rights) h:p_oly right) c_at face
}
## A built kind's model (bridge, wall, gate; "" for a kind drawn as the
## ground it is) and how far under the tile's top the model's base is,
## in the world's units: a bridge's deck is half a tile up from its
## base, a wall two tiles tall, and a gate stands on its tile.
h:built := "" "" "bridge" "" "wall" "" "gate" ""
h:drops := 0.0 0.0 0.5 0.0 2.0 0.0 0.0 0.0
## The scene's tiles of one kind, a line: tiles('kind', 'color',
## nums('x z y ...', 3)), the middle of each tile and its top, in the
## world's units (a tile is 1 wide, a step of elevation 0.5). A built
## kind is drawn with its model: tiles('kind', 'color', nums('x z y
## base ...', 4), 'model'), the model's base at base.
h:t_ilesCall := { (rows, cols, kinds, heights) k ->
  is := w_here kinds = k
  0 = t_ally is ? ""
  x := (f_loat is s_elect cols) - 0.5
  z := (f_loat is s_elect rows) - 0.5
  y := 0.5 * is s_elect heights
  model := d_isclose k s_elect h:built
  start := "tiles('" c_at (d_isclose k s_elect w:kinds) c_at "', '" c_at (d_isclose k s_elect h:tops) c_at "', nums('"
  0 = t_ally model ? start c_at (f_ormat h:f_ine r_avel o_\ (3 c_at t_ally is) r_eshape x c_at z c_at y) c_at "', 3))\n"
  start c_at (f_ormat h:f_ine r_avel o_\ (4 c_at t_ally is) r_eshape x c_at z c_at y c_at y - k s_elect h:drops) c_at "', 4), '" c_at model c_at "')\n"
}
## A map's parts every stage has: its frame, its tiles' SVG far to near
## a band a depth (the tiles of one diagonal joined, in the order they
## are drawn) and the bands' depths, and the pieces of the scene's
## ground.
h:p_arts := { map ->
  frame := h:f_rame map
  rc := w:s_ize map
  kinds := r_avel w:t_iles map
  heights := f_loat r_avel w:h_eights map
  n := t_ally kinds
  rows := 1 + ((r_ange n) - 1) d_iv 2 s_elect rc
  cols := 1 + ((r_ange n) - 1) m_od 2 s_elect rc
  far := g_rade rows + cols
  tiles := '{ i -> e_nclose frame h:t_ileSvg (i s_elect rows, i s_elect cols, i s_elect kinds, i s_elect heights) } e_ach far
  depth := far s_elect rows + cols
  bands := 1 + r_ange (-1 + '+ r_/ rc)
  joined := '{ d -> e_nclose t:j_oin (depth = d) r_eplicate tiles } e_ach bands
  calls := '{ k -> e_nclose (rows, cols, kinds, heights) h:t_ilesCall k } e_ach r_ange t_ally w:kinds
  (frame, joined, f_loat bands, calls)
}
# :: (Any a, Num b, Num c) => (a, Int, b) -> ((a, Int, b), Float, Box Char, Float, Char, c)
## A map made ready to draw, once. A mode makes it in its n_ew and keeps
## it: drawing a tick then costs only the pieces.
l:s_tage := { map ->
  (frame, tiles, depths, calls) := h:p_arts map
  (map, frame, tiles, depths, t:j_oin calls, 0)
}
# :: (Any a, Num b, Num c) => (a, Int, b) -> ((a, Int, b), Float, Box Char, Float, Char, c)
## The same with its ground smooth (lib/Terrain): the scene's ground is
## one terrain mesh under grass, worn to dirt on roads; round it a band
## of ground 24 tiles wide and then ground to the horizon, so the map
## does not float; the river is a water surface that flows; tiles are
## left only for the built kinds. A piece stands on the surface, not
## on a step. The flat
## picture and the click's way back to a tile are a stage's.
l:s_mooth := { map ->
  (frame, tiles, depths, calls) := h:p_arts map
  rc := w:s_ize map
  far := 24
  edge := "nums('" c_at (f_ormat 0.0 0.0 c_at f_loat r_ev rc) c_at "', 4)[0]"
  land := (tr:c_all map) c_at "ground('ground', 'grass', 'dirt', nums('" c_at (f_ormat tr:w_orn map) c_at "', 1))\n"
  round := (tr:c_allAround (map, far)) c_at "ground('around', 'grass', 'dirt', nums('" c_at (f_ormat ((3 + f_irst rc) * 3 + 2 s_elect rc) r_eshape 0.0) c_at "', 1))\n"
  beyond := "beyond(0.0, 'grass', '" c_at (d_isclose f_irst h:tops) c_at "', nums('" c_at (f_ormat (0.0 - f_loat far) c_at (0.0 - f_loat far) c_at (f_loat far + 2 s_elect rc) c_at f_loat far + f_irst rc) c_at "', 4)[0])\n"
  river := tr:c_allWater (map, 0, 0.35 0.0, "#3f6f8f")
  (map, frame, tiles, depths, land c_at round c_at beyond c_at river c_at t:j_oin 3 5 7 s_elect calls, 1)
}
# :: (Any a, Num b, Num c) => ((a, Int, b), Float) -> ((a, Int, b), Float, Box Char, Float, Char, c)
## The smooth stage in snow: (map, amount), amount from 0 to 1. The
## ground is white (trodden brown along the roads), under the player's
## snow texture, round the map and on to the horizon; snow falls over
## it all (a particle kind a player may not have yet: then none
## falls); the river runs dark. The flat picture is whitened to match,
## as strongly as the snow is thick.
l:w_inter := { (map, amount) ->
  (frame, tiles, depths, calls) := h:p_arts map
  rc := w:s_ize map
  far := 24
  land := (tr:c_allSnow (map, far)) c_at "ground('ground', 'snow', 'dirt', nums('" c_at (f_ormat h:f_ine 1.0 m_in 1.8 * tr:w_orn map) c_at "', 1))\nground('around', 'snow', 'snow', nums('" c_at (f_ormat ((3 + f_irst rc) * 3 + 2 s_elect rc) r_eshape 0.0) c_at "', 1))\n"
  beyond := "beyond(0.0, 'snow', '#f2f5f9', nums('" c_at (f_ormat (0.0 - f_loat far) c_at (0.0 - f_loat far) c_at (f_loat far + 2 s_elect rc) c_at f_loat far + f_irst rc) c_at "', 4)[0])\n"
  river := tr:c_allWater (map, 0, 0.25 0.0, "#2c3f52")
  falls := "particles('snow', nums('" c_at (f_ormat h:f_ine (0.5 * f_loat 2 s_elect rc) c_at (0.5 * f_loat f_irst rc) c_at 8.0) c_at "', 3)[0], " c_at (f_ormat h:w_hole 400.0 * amount) c_at ", nums('0.3 0.1', 2)[0], 1)\n"
  w := f_ormat h:w_hole 3 s_elect frame
  h := f_ormat h:w_hole 4 s_elect frame
  over := "<rect width=\"" c_at w c_at "\" height=\"" c_at h c_at "\" fill=\"#f2f5f9\" fill-opacity=\"" c_at (f_ormat h:f_ine 0.45 * amount) c_at "\"/>"
  (map, frame, tiles c_at e_nclose over, depths c_at 999999.0, land c_at beyond c_at river c_at falls c_at t:j_oin 3 5 7 s_elect calls, 1)
}
# :: (Any a, Any b, Any c, Any d, Any f) => ((a, b, c, d, e, f), e) -> (a, b, c, d, e, f)
## A stage with more in its scene: (stage, lines), scene lines put after
## its ground's (scenery a library has worked out: a village behind the
## wall). The flat picture is as it was.
l:d_ressed := { (stage, lines) ->
  (map, frame, tiles, depths, ground, smooth) := stage
  (map, frame, tiles, depths, ground c_at lines, smooth)
}
# :: (Any a, Num c, Truthy c, Any d, Any e, Any f, Any g, Any h, Any i) => (((a, b, c), Float, d, e, f, g), Box Char, h, Float, i) -> Float -> Int
## The label under a picture point: view vw:l_abelled (px, py), which
## of the view's labels (its pieces written with #, counted in their
## order) has the point on its words, or 0 for none. A label is as
## wide as its words and as high as a line, so a place is chosen by a
## click anywhere on its name; where two labels' words meet, the one
## whose middle is nearer.
l:l_abelled := { (stage, models, _, pieces, _) p ->
  (map, frame, _, _, _, _) := stage
  which := h:w_ritten models
  0 = '+ r_/ which ? 0
  xy := (1 2) s_elect_2 which r_eplicate pieces
  at := frame h:t_o xy c_at_2 ((t_ally xy) c_at 1) r_eshape map h:u_nder xy
  half := 3.0 + 2.9 * f_loat '{ w -> (t_ally d_isclose w) - 1 } e_ach which r_eplicate models
  off := a_bs (f_irst_2 at) - f_irst p
  on := (off <= half) & (a_bs ((2 s_elect_2 at) - 38.0) - 2 s_elect p) <= 8.0
  0 = '+ r_/ on ? 0
  f_irst w_here on & off = 'm_in r_/ off + 100000.0 * f_loat n_ot on
}
# :: (Any a, Any c, Any d, Any e, Any f, Any g, Any h) => ((a, b, c), d, e, f, g, h) -> Int
## The places of a stage's tiles in the order they are drawn, far to
## near, a row each (row, column).
l:f_arToNear := { (map, _, _, _, _, _) ->
  rc := w:s_ize map
  n := '* r_/ rc
  rows := 1 + ((r_ange n) - 1) d_iv 2 s_elect rc
  cols := 1 + ((r_ange n) - 1) m_od 2 s_elect rc
  far := g_rade rows + cols
  o_\ (2 c_at n) r_eshape (far s_elect rows) c_at far s_elect cols
}

### Light

# :: (Any a, Any b) => ((a, Float, Box Char, Float, Char, b), Float) -> (a, Float, Box Char, Float, Char, b)
## A stage lit by a light (lib/Sky: an hour's sun, sky and haze):
## (stage, light) to a stage. Its scene begins with the light's three
## calls, for a player to light it and cast its shadows by; its flat
## picture is washed over, tiles and pieces alike, with the sky's color
## as strongly as the hour is dark.
l:l_it := { (stage, light) ->
  (map, frame, tiles, depths, ground, smooth) := stage
  (color, wash) := sk:t_int light
  w := f_ormat h:w_hole 3 s_elect frame
  h := f_ormat h:w_hole 4 s_elect frame
  over := "<rect width=\"" c_at w c_at "\" height=\"" c_at h c_at "\" fill=\"" c_at color c_at "\" fill-opacity=\"" c_at (f_ormat wash) c_at "\"/>"
  (map, frame, tiles c_at e_nclose over, depths c_at 1000000.0, (sk:c_alls light) c_at ground, smooth)
}

### A view

# :: (Any a, Any b) => (a, b) -> (a, Box Char, Box Char, Float, b)
## A view with no pieces: (stage, caption).
l:e_mpty := { (stage, caption) -> (stage, 0 t_ake e_nclose "", 0 t_ake e_nclose "", 0 8 r_eshape 0.0, caption) }
# :: (Any a, Any b, Any c) => (a, b, Char, Float, c) -> (a, Box b, Box Char, Float, c)
## A view of one piece: (stage, model, clip, its eight numbers, caption).
l:o_ne := { (stage, model, clip, numbers, caption) -> (stage, 1 r_eshape e_nclose model, 1 r_eshape e_nclose clip, 1 8 r_eshape numbers, caption) }
# :: (Any a, Any e) => (a, b, c, d, e) -> (a, b, c, d, e)
## A view of many pieces: (stage, models, clips, pieces, caption), a
## model and a clip a piece (lists of texts) and its eight numbers a
## row. As many of each as there are pieces, or it is an error.
l:m_any := { (stage, models, clips, pieces, caption) ->
  n_ot ((t_ally models) = t_ally clips) & ((t_ally models) c_at 8) m_atch s_hape pieces ? "bad-view" []S_IGNAL "a view's pieces: a model, a clip and eight numbers each"
  (stage, models, clips, pieces, caption)
}
# :: (Any a, Any b, Any c, Any e) => ((a, Box b, Box c, d, e), b, c, d) -> (a, Box b, Box c, d, e)
## A view with one more piece: (view, model, clip, its eight numbers).
## A model that begins with a hash is a label: its words are written
## over the picture at its place ("#3 The town"), and it is no part of
## the scene. A model that begins with a star is a burst of particles at its
## place ("*fire", "*dust" ...: its heading the wind, t how many a
## second, its last number a seed), which only the scene shows. A
## model that begins with a tilde is the music's lines and one that
## begins with ^ the sound strip's level and mute ("^6 0"; lib/Mode
## adds both to every view): only the picture shows them, the music in
## its metadata id="music" and the strip at its top right.
## A model that begins with @ is a mini map (vw:m_ini makes it): the
## map's tiles you may walk on, the gate, and the piece's place and
## heading on them, drawn small at the picture's top left, over a 3D
## view too; no part of the scene or the text.
## The model "eye" is not a thing to draw but where you look from: its
## place and heading, its pitch in degrees where a piece has its
## clip's time, and the tick's length last. The scene is then seen
## through it, in perspective, in place of the board's own camera; the
## flat picture and the text mark where you stand.
l:w_ith := { ((stage, models, clips, pieces, caption), model, clip, numbers) ->
  (stage, models c_at e_nclose model, clips c_at e_nclose clip, pieces c_at 1 8 r_eshape numbers, caption)
}
# :: (Any a, Any b, Any c) => (a, b, c) -> (a, Box b, Box Char, Float, c)
## A view that is a picture already drawn: (stage, svg, caption). The
## picture is shown as it is (no scene: the page shows it flat), and
## its text is its caption.
l:d_rawn := { (stage, svg, caption) -> l:o_ne (stage, svg, "", 8 r_eshape 0.0, caption) }
# :: (Any a, Any b, Any c, Any d, Any e) => (a, b, c, d, e) -> e
## The view's caption: the line a mode says under its picture.
l:c_aption := { (_, _, _, _, caption) -> caption }

### The drawing in text

# :: (Any a, Any b, Any c, Any d, Any e, Any f, Any g, Any h) => (((a, Int, b), c, d, e, f, g), Box Char, h, Float, Char) -> Char
## The view as text: the map's letters, a row a line, each piece as @ on
## the tile it stands on, and the caption under it.
l:t_ext := { (stage, models, _, every, caption) ->
  0 < t_ally h:d_rawing models ? caption c_at h:p_anelText models
  pieces := ((h:s_olid models) & h:n_ear every) r_eplicate every
  (map, _, _, _, _, _) := stage
  drawing := w:d_raw map
  k := 2 s_elect s_hape drawing
  at := (1 + f_loor f_irst_2 pieces) + k * f_loor 2 s_elect_2 pieces
  flat := r_avel drawing
  on := (r_ange t_ally flat) m_ember? at
  rows := (s_hape drawing) r_eshape (((n_ot on) * r_ange t_ally flat) + on * 1 + t_ally flat) s_elect flat c_at "@"
  ("\n" st:j_oin '{ i -> e_nclose i s_elect rows } e_ach r_ange f_irst s_hape drawing) c_at "\n" c_at caption c_at h:p_anelText models
}

## Which of a view's pieces are things standing on the board: not a
## burst (a model that begins with a star), which only a scene shows.
h:s_olid := { models -> '{ m -> n_ot (f_irst (d_isclose m) c_at " ") m_ember? "*#<~^%@" } e_ach models }
## The text after a mark, of the first model that begins with it, or an
## empty text.
h:m_arked := { mark models ->
  is := '{ m -> mark m_atch 1 t_ake d_isclose m } e_ach models
  0 = '+ r_/ is ? ""
  1 d_rop d_isclose f_irst is r_eplicate models
}
## The music's metadata, or nothing: a model that begins with ~ is the
## music's lines (lib/Mode and lib/Music), written in the picture's
## metadata id="music" for a page to play; no part of the scene or the
## text.
h:t_une := { models ->
  line := "~" h:m_arked models
  0 = t_ally line ? ""
  "<metadata id=\"music\">" c_at line c_at "</metadata>"
}
## How wide and high a picture a game drew itself is: its viewBox's
## (800 by 600 if it has none).
h:s_ize := { svg ->
  at := "viewBox=\"" st:f_ind svg
  0 = t_ally at ? 800.0 600.0
  rest := (8 + f_irst at) d_rop svg
  box := f_loat n_umbers ((f_irst w_here rest = f_irst "\"") - 1) t_ake rest
  4 > t_ally box ? 800.0 600.0
  2 t_ake 2 d_rop box
}
## How wide and high a view's picture is: (the game's own drawing or
## "", the stage's frame).
h:w_h := { (drawn, frame) -> 0 < t_ally drawn ? h:s_ize drawn; 3 4 s_elect frame }
## The sound strip's place and size in a view's picture: its top left
## corner and how many picture units are one of its own (it is 168 by
## 28 of them). At the top right of a stage's picture; at the bottom
## right of a picture a game drew itself, whose top is often its own
## menu: (the game's drawing or "", the stage's frame).
h:p_lace := { (drawn, frame) ->
  wh := h:w_h (drawn, frame)
  s := 1.0 m_ax (f_irst wh) / 800.0
  x := (f_irst wh) - s * 176.0
  0 = t_ally drawn ? (x, s * 8.0, s)
  (x, (2 s_elect wh) - s * 40.0, s)
}
## What comes out of the strip's speaker: sound waves, or a red cross
## when muted.
h:w_aves := { mute ->
  mute = 1 ? "<path d=\"M19 9l7 10M26 9l-7 10\" stroke=\"#e0503c\" stroke-width=\"2.5\"/>"
  "<path d=\"M19 9q4 5 0 10M22 6q7 8 0 16\" fill=\"none\" stroke=\"#e8e6df\" stroke-width=\"2\"/>"
}
## A level and mute from the model "^LEVEL MUTE".
h:s_ound := { models ->
  both := f_loor n_umbers "^" h:m_arked models
  (f_irst both, 2 s_elect both)
}
## The strip's SVG: a speaker (crossed when muted), quieter, the level,
## louder, and the gear that opens the settings panel; nothing for a
## view without a strip.
h:s_tripSvg := { (models, place) ->
  0 = t_ally "^" h:m_arked models ? ""
  (level, mute) := h:s_ound models
  (x, y, s) := place
  b_ox := { (at, what) -> "<g data-control=\"" c_at what c_at "\"><rect x=\"" c_at at c_at "\" width=\"28\" height=\"28\" rx=\"5\" fill=\"#2b2e3d\" stroke=\"#a8a08a\"/>" }
  s_ign := { (at, what) -> "<text x=\"" c_at at c_at "\" y=\"21\" text-anchor=\"middle\" font-size=\"20\" fill=\"#e8e6df\">" c_at what c_at "</text></g>" }
  speaker := (b_ox ("0", "mute")) c_at "<path d=\"M5 11h4l6-5v16l-6-5h-4z\" fill=\"#e8e6df\"/>" c_at (h:w_aves mute) c_at "</g>"
  number := "<text x=\"80\" y=\"20\" text-anchor=\"middle\" font-size=\"16\" fill=\"#e8e6df\">" c_at (f_ormat level) c_at "</text>"
  gear := (b_ox ("132", "settings")) c_at "<circle cx=\"146\" cy=\"14\" r=\"7\" fill=\"none\" stroke=\"#e8e6df\" stroke-width=\"4\" stroke-dasharray=\"3 2.5\"/><circle cx=\"146\" cy=\"14\" r=\"3\" fill=\"#e8e6df\"/></g>"
  "<g class=\"sound\" transform=\"translate(" c_at (f_ormat h:f_ine x) c_at " " c_at (f_ormat h:f_ine y) c_at ") scale(" c_at (f_ormat h:f_ine s) c_at ")\"><rect x=\"-4\" y=\"-4\" width=\"176\" height=\"36\" rx=\"8\" fill=\"#14151c\" fill-opacity=\"0.6\"/>" c_at speaker c_at (b_ox ("34", "down")) c_at (s_ign ("48", "-")) c_at number c_at (b_ox ("98", "up")) c_at (s_ign ("112", "+")) c_at gear c_at "</g>"
}
## The settings panel's rows (lib/Mode's loop): the music's volume, on
## or muted, resume playing, exit to the start menu.
h:p_anelRows := { models ->
  (level, mute) := h:s_ound models
  (e_nclose "Music volume: " c_at (f_ormat level) c_at " of 10") c_at (e_nclose "Music: " c_at d_isclose (1 + mute) s_elect "on" "muted") c_at "Resume playing" "Exit to start menu"
}
## The panel's chosen row, or 0 when it is closed: a model "%ROW".
h:p_anelRow := { models ->
  said := "%" h:m_arked models
  0 = t_ally said ? 0
  f_irst f_loor n_umbers said
}
## The panel's place and size in a view's picture: its top left corner
## and how many picture units are one of its own (it is 420 by 270 of
## them, in the middle).
h:p_anelAt := { (drawn, frame) ->
  wh := h:w_h (drawn, frame)
  s := 1.0 m_ax (f_irst wh) / 800.0
  (0.5 * (f_irst wh) - s * 420.0, 0.5 * (2 s_elect wh) - s * 270.0, s)
}
## The panel's text: a line for its title, a line a row, the chosen one
## marked; nothing when it is closed.
h:p_anelText := { models ->
  row := h:p_anelRow models
  0 = row ? ""
  rows := h:p_anelRows models
  "\nPaused: settings (Up Down, Left Right, Enter)" c_at t:j_oin '{ i -> e_nclose "\n" c_at (d_isclose (1 + i = row) s_elect "  " "> ") c_at d_isclose i s_elect rows } e_ach r_ange 4
}
## The panel's SVG over the picture: a dark box, its title, a row a
## line (the chosen one lit); nothing when it is closed.
h:p_anelSvg := { (models, place) ->
  row := h:p_anelRow models
  0 = row ? ""
  rows := h:p_anelRows models
  (x, y, s) := place
  r_ow := { i -> "<g data-row=\"" c_at (f_ormat i) c_at "\"><rect x=\"20\" y=\"" c_at (f_ormat 34 + 46 * i) c_at "\" width=\"380\" height=\"38\" rx=\"6\" fill=\"" c_at (d_isclose (1 + i = row) s_elect "#2b2e3d" "#6b5a2e") c_at "\" stroke=\"#a8a08a\"/><text x=\"36\" y=\"" c_at (f_ormat 59 + 46 * i) c_at "\" text-anchor=\"start\" font-size=\"18\" fill=\"#e8e6df\">" c_at (d_isclose i s_elect rows) c_at "</text></g>" }
  "<g class=\"sound panel\" transform=\"translate(" c_at (f_ormat h:f_ine x) c_at " " c_at (f_ormat h:f_ine y) c_at ") scale(" c_at (f_ormat h:f_ine s) c_at ")\"><rect width=\"420\" height=\"270\" rx=\"10\" fill=\"#14151c\" fill-opacity=\"0.92\" stroke=\"#a8a08a\"/><text x=\"210\" y=\"30\" text-anchor=\"middle\" font-size=\"20\" fill=\"#e8e6df\">Paused: settings</text>" c_at (t:j_oin '{ i -> e_nclose r_ow i } e_ach r_ange 4) c_at "</g>"
}
## A picture a game drew itself with the music's metadata, the sound's
## strip and the panel put in, just before its end.
h:w_ithSound := { (svg, models) ->
  frame := 0.0 0.0 0.0 0.0
  more := (h:t_une models) c_at (h:s_tripSvg (models, h:p_lace (svg, frame))) c_at h:p_anelSvg (models, h:p_anelAt (svg, frame))
  0 = t_ally more ? svg
  n_ot "</svg>" m_atch -6 t_ake svg ? svg c_at more
  (-6 d_rop svg) c_at more c_at "</svg>"
}
# :: (Any a, Any b, Any c, Any d, Any e, Any f, Any g, Any h, Num i) => ((a, Float, b, c, d, e), Box Char, f, g, h) -> Float -> i
## Which of the sound strip's controls a picture point is on: view
## vw:s_trip (px, py), 1 the speaker (mute), 2 quieter, 3 louder, 4 the
## gear (the settings panel), or 0 for none (and for a view with no
## strip).
l:s_trip := { (stage, models, _, _, _) p ->
  0 = t_ally "^" h:m_arked models ? 0
  (_, frame, _, _, _, _) := stage
  (x, y, s) := h:p_lace (h:d_rawing models, frame)
  u := ((f_irst p) - x) / s
  v := ((2 s_elect p) - y) / s
  (v < 0.0) | v > 28.0 ? 0
  (u >= 0.0) & u <= 28.0 ? 1
  (u >= 34.0) & u <= 62.0 ? 2
  (u >= 98.0) & u <= 126.0 ? 3
  (u >= 132.0) & u <= 160.0 ? 4
  0
}
# :: (Any a, Any b, Any c, Any d, Any e, Any f, Any g, Any h) => ((a, Float, b, c, d, e), Box Char, f, g, h) -> Float -> Int
## Which of the settings panel's rows a picture point is on: view
## vw:p_anel (px, py), 1 to 4, or 0 for none (and when it is closed).
l:p_anel := { (stage, models, _, _, _) p ->
  0 = h:p_anelRow models ? 0
  (_, frame, _, _, _, _) := stage
  (x, y, s) := h:p_anelAt (h:d_rawing models, frame)
  u := ((f_irst p) - x) / s
  v := ((2 s_elect p) - y) / s
  (u < 20.0) | u > 400.0 ? 0
  r := f_loor (v - 34.0) / 46.0
  (r < 1) | r > 4 ? 0
  (v - 34.0 + 46.0 * f_loat r) > 38.0 ? 0
  r
}
## A view's own drawing, or an empty text: a model that begins with <
## is a whole picture (an SVG), drawn by a game that draws itself (one
## taken from X_eTaL-games), and is shown as it is in place of the
## stage's.
h:d_rawing := { models ->
  is := '{ m -> "<" m_atch 1 t_ake d_isclose m } e_ach models
  0 = '+ r_/ is ? ""
  d_isclose f_irst is r_eplicate models
}
## Which are labels: a model that begins with a hash is words written
## over the picture at its place (and over a 3D view of the scene, which
## the picture lies on), not a thing in the scene.
h:w_ritten := { models -> '{ m -> "#" m_atch 1 t_ake d_isclose m } e_ach models }
## The labels' SVG: each a line of words centered a little above its
## place, with a dark edge to read over anything.
h:l_abels := { (stage, models, pieces) ->
  (map, frame, _, _, _, _) := stage
  which := h:w_ritten models
  xy := (1 2) s_elect_2 which r_eplicate pieces
  p := frame h:t_o xy c_at_2 ((t_ally xy) c_at 1) r_eshape map h:u_nder xy
  words := which r_eplicate models
  t:j_oin '{ i -> e_nclose "<text x=\"" c_at (f_ormat h:w_hole f_irst i s_elect p) c_at "\" y=\"" c_at (f_ormat h:w_hole (2 s_elect i s_elect p) - 34.0) c_at "\" font-size=\"11\" text-anchor=\"middle\" fill=\"#ffffff\" stroke=\"#14151c\" stroke-width=\"3\" paint-order=\"stroke\">" c_at (1 d_rop d_isclose f_irst (i - 1) d_rop words) c_at "</text>" } e_ach r_ange t_ally words
}

## Which pieces are on or near the map: one far off it (a mode keeps a
## piece waiting there, to be the same piece when it comes) is not in
## the flat picture or the text.
h:n_ear := { pieces -> ((f_irst_2 pieces) > -100.0) & (2 s_elect_2 pieces) > -100.0 }

### The mini map

# :: (Any a, Num b, Any c, Any d, Any e, Any f, Any g, Any h, Truthy i) => (((a, b, c), d, e, f, g, h), i) -> Char
## A mini map's model, for a view's piece (its numbers say where the
## piece is and which way it faces): (stage, closed), closed a matrix
## of the map's shape, 1 where you may not walk (a mode's own walls,
## buildings, water). Drawn once, so a mode makes it in its n_ew and
## keeps it: "@", how big a tile is drawn, then the map's SVG, a dark
## ground, a light rect a run of open tiles along a row, and the gate.
l:m_ini := { (stage, closed) ->
  (map, _, _, _, _, _) := stage
  rc := w:s_ize map
  cols := 2 s_elect rc
  s := 8.0 m_in (240.0 / f_loat cols) m_in 160.0 / f_loat f_irst rc
  gate := 7 = r_avel w:t_iles map
  open := n_ot r_avel closed
  col := ((r_ange t_ally open) - 1) m_od cols
  starts := w_here open & (col = 0) | n_ot 0 c_at -1 d_rop open
  ends := w_here open & (col = cols - 1) | n_ot (1 d_rop open) c_at 0
  r_un := { (x, y, w, what, fill) -> e_nclose "<rect class=\"" c_at what c_at "\" fill=\"" c_at fill c_at "\" x=\"" c_at (f_ormat h:f_ine x) c_at "\" y=\"" c_at (f_ormat h:f_ine y) c_at "\" width=\"" c_at (f_ormat h:f_ine w) c_at "\" height=\"" c_at (f_ormat h:f_ine s) c_at "\"/>" }
  x := s * f_loat (starts - 1) m_od cols
  y := s * f_loat (starts - 1) d_iv cols
  w := s * f_loat 1 + ends - starts
  streets := t:j_oin '{ j -> r_un (j s_elect x, j s_elect y, j s_elect w, "street", "#c8c2b0") } e_ach r_ange t_ally starts
  g := (w_here gate) - 1
  doors := t:j_oin '{ j -> r_un (s * f_loat j m_od cols, s * f_loat j d_iv cols, s, "door", "#2a9d8f") } e_ach g
  ground := "<rect x=\"-4\" y=\"-4\" width=\"" c_at (f_ormat h:f_ine 8.0 + s * f_loat cols) c_at "\" height=\"" c_at (f_ormat h:f_ine 8.0 + s * f_loat f_irst rc) c_at "\" rx=\"4\" fill=\"#14151c\" fill-opacity=\"0.75\"/>"
  "@" c_at (f_ormat h:f_ine s) c_at " " c_at ground c_at streets c_at doors
}
## The mini map's SVG at the picture's top left, or nothing for a view
## without one: the map its model drew, and the piece on it, a dot and
## a line the way it faces.
h:m_iniSvg := { (models, pieces) ->
  is := '{ m -> "@" m_atch 1 t_ake d_isclose m } e_ach models
  0 = '+ r_/ is ? ""
  said := 1 d_rop d_isclose f_irst is r_eplicate models
  gap := f_irst w_here said = f_irst " "
  s := f_irst n_umbers (gap - 1) t_ake said
  p := f_irst is r_eplicate pieces
  px := f_ormat h:f_ine s * f_irst p
  py := f_ormat h:f_ine s * 2 s_elect p
  far := s * 1.6
  you := "<g class=\"you\"><circle cx=\"" c_at px c_at "\" cy=\"" c_at py c_at "\" r=\"" c_at (f_ormat h:f_ine 0.5 * s) c_at "\" fill=\"#e63946\"/><line x1=\"" c_at px c_at "\" y1=\"" c_at py c_at "\" x2=\"" c_at (f_ormat h:f_ine (s * f_irst p) + far * 3 s_elect p) c_at "\" y2=\"" c_at (f_ormat h:f_ine (s * 2 s_elect p) + far * 4 s_elect p) c_at "\" stroke=\"#e63946\" stroke-width=\"" c_at (f_ormat h:f_ine 0.3 * s) c_at "\"/></g>"
  "<g class=\"minimap\" transform=\"translate(" c_at (f_ormat h:edge) c_at " " c_at (f_ormat h:edge) c_at ")\">" c_at (gap d_rop said) c_at you c_at "</g>"
}

### The picture

h:colors := "#c0392b" "#7f8c8d"
h:models := 1 r_eshape e_nclose "walker"
## One piece's SVG: a shadow on the ground, a body and a head, where
## the board point under it is drawn.
h:p_ieceSvg := { (px, py) model ->
  fill := d_isclose (h:models i_ndexOf e_nclose model) s_elect h:colors
  x := f_ormat h:w_hole px
  shadow := "<ellipse cx=\"" c_at x c_at "\" cy=\"" c_at (f_ormat h:w_hole py) c_at "\" rx=\"7\" ry=\"3\" fill=\"#000000\" fill-opacity=\"0.35\"/>"
  body := "<rect x=\"" c_at (f_ormat h:w_hole px - 4.0) c_at "\" y=\"" c_at (f_ormat h:w_hole py - 15.0) c_at "\" width=\"8\" height=\"14\" rx=\"3\" fill=\"" c_at fill c_at "\"/>"
  head := "<circle cx=\"" c_at x c_at "\" cy=\"" c_at (f_ormat h:w_hole py - 19.0) c_at "\" r=\"4\" fill=\"#f1c9a5\"/>"
  shadow c_at body c_at head
}
## The pieces' SVG, and the depth each is drawn at: just after the tile
## it stands on.
h:p_iecesSvg := { (stage, all, every) ->
  solid := (h:s_olid all) & h:n_ear every
  models := solid r_eplicate all
  pieces := solid r_eplicate every
  (map, frame, _, _, _, _) := stage
  xy := (1 2) s_elect_2 pieces
  p := frame h:t_o xy c_at_2 ((t_ally pieces) c_at 1) r_eshape map h:u_nder xy
  '{ i -> e_nclose (f_irst i s_elect p, 2 s_elect i s_elect p) h:p_ieceSvg d_isclose f_irst (i - 1) d_rop models } e_ach r_ange t_ally pieces
}
h:d_epths := { pieces -> 2.5 + (f_loat f_loor f_irst_2 pieces) + f_loat f_loor 2 s_elect_2 pieces }
# :: (Any a, Num b, Truthy b, Num c) => (((a, Int, b), Float, Box Char, Float, Char, c), Box Char, Box Char, Float, Char) -> Char
## The flat picture: an SVG document. The tiles and the pieces are drawn
## far to near (a piece just after the tile it stands on, so a wall
## nearer the eye hides it), then the caption, a line of it a line of
## the picture, the last at the bottom. What a 3D view replaces
## is in a group of class "flat", and the scene is the picture's
## metadata, so a page that can draw the scene does, and hides the flat
## group; one that cannot shows the picture as it is.
l:p_icture := { view ->
  (stage, models, _, pieces, caption) := view
  0 < t_ally h:d_rawing models ? h:w_ithSound (h:d_rawing models, models)
  (_, frame, tiles, depths, _, _) := stage
  all := tiles c_at h:p_iecesSvg (stage, models, pieces)
  order := g_rade depths c_at h:d_epths ((h:s_olid models) & h:n_ear pieces) r_eplicate pieces
  w := f_ormat h:w_hole 3 s_elect frame
  h := f_ormat h:w_hole 4 s_elect frame
  head := "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 " c_at w c_at " " c_at h c_at "\" width=\"" c_at w c_at "\" height=\"" c_at h c_at "\" font-family=\"sans-serif\">"
  back := "<rect class=\"flat\" width=\"" c_at w c_at "\" height=\"" c_at h c_at "\" fill=\"#1d1f2b\"/>"
  said := st:l_ines caption
  words := t:j_oin '{ i -> e_nclose "<text x=\"" c_at (f_ormat h:w_hole h:edge) c_at "\" y=\"" c_at (f_ormat h:w_hole ((4 s_elect frame) - h:edge) - 20.0 * f_loat (t_ally said) - i) c_at "\" font-size=\"16\" fill=\"#e8e6df\">" c_at (d_isclose f_irst (i - 1) d_rop said) c_at "</text>" } e_ach r_ange t_ally said
  front := head c_at "<metadata id=\"scene\">"
  middle := "</metadata>" c_at (h:t_une models) c_at back c_at "<g class=\"flat\">"
  after := "</g>" c_at (h:l_abels (stage, models, pieces)) c_at words c_at (h:m_iniSvg (models, pieces)) c_at (h:s_tripSvg (models, h:p_lace ("", frame))) c_at (h:p_anelSvg (models, h:p_anelAt ("", frame))) c_at "</svg>"
  (front c_at l:s_cene view) c_at (middle c_at t:j_oin order s_elect all) c_at after
}

### The scene

h:n_ums := { (v, k) -> "nums('" c_at (f_ormat h:f_ine v) c_at "', " c_at (f_ormat k) c_at ")" }
## Where pieces stand in the scene, in the world's units: on their
## tile's step, or on a smooth stage's surface. All of a view's pieces
## are asked at once: the surface is worked out once a scene, not once
## a piece.
h:s_tands := { (map, smooth) xy -> smooth = 1 ? map tr:s_tand xy; 0.5 * map h:u_nder xy }
## The eye's call, in place of a piece's: eye(nums('x z y', 3)[0],
## nums('hx hz pitch', 3)[0], lens, dt): where it is (its own height
## above what it stands on), the way it looks, and the seconds it takes
## to come there. Of an eye's eight numbers t is its pitch in degrees.
h:e_yeCall := { (y, n) ->
  "eye(" c_at (h:n_ums ((2 t_ake n) c_at h:tall + y, 3)) c_at "[0], " c_at (h:n_ums ((2 t_ake 2 d_rop n) c_at 5 s_elect n, 3)) c_at "[0], 60, " c_at (f_ormat h:f_ine 8 s_elect n) c_at ")\n"
}
## A burst's call, in place of a piece's, for a model that begins with
## a star ("*fire", "*smoke", "*dust", "*splash", "*embers"):
## particles('kind', nums('x z y', 3)[0], rate, nums('wx wz', 2)[0],
## seed), coming from half a tile above the ground at its place. Of its
## eight numbers the heading is the wind, t is how many a second, and
## the last is its seed (a whole number that tells one emitter of a
## kind from another).
h:b_urstCall := { (kind, y, n) ->
  "particles('" c_at kind c_at "', " c_at (h:n_ums ((2 t_ake n) c_at 0.5 + y, 3)) c_at "[0], " c_at (f_ormat h:w_hole 5 s_elect n) c_at ", " c_at (h:n_ums (2 t_ake 2 d_rop n, 2)) c_at "[0], " c_at (f_ormat h:w_hole 8 s_elect n) c_at ")\n"
}
## How high an eye is above the ground it stands on, in tiles.
h:tall := 0.5
## One piece's call: piece('model', nums('x z y hx hz', 5)[0], 'clip',
## t, nums('x2 z2 y2', 3)[0], dt), from its model, its clip, the height
## it stands at now and where it will be, and its eight numbers.
h:p_ieceCall := { (model, clip, y, y2, n) ->
  model m_atch "eye" ? h:e_yeCall (y, n)
  "#" m_atch 1 t_ake model ? ""
  (f_irst model) m_ember? "~^%@" ? ""
  "*" m_atch 1 t_ake model ? h:b_urstCall (1 d_rop model, y, n)
  from := (2 t_ake n) c_at y c_at 2 t_ake 2 d_rop n
  to := (2 t_ake 5 d_rop n) c_at y2
  "piece('" c_at model c_at "', " c_at (h:n_ums (from, 5)) c_at "[0], '" c_at clip c_at "', " c_at (f_ormat h:f_ine 5 s_elect n) c_at ", " c_at (h:n_ums (to, 3)) c_at "[0], " c_at (f_ormat h:f_ine 8 s_elect n) c_at ")\n"
}
# :: (Any a, Num b, Truthy b, Num c) => (((a, Int, b), Float, Box Char, Float, Char, c), Box Char, Box Char, Float, Char) -> Char
## The scene: the calls of a 3D player, a line each, as X_eTaL-extensions
## writes scenes (text that names no renderer).
##   view(width, height, 'background')      the picture's size
##   camera(target, direction, scale)       looking at the board point in
##     the middle of the picture, from 30 degrees up along the board's
##     diagonal, without perspective, scale picture units to a tile: it
##     sees the board as the picture's map does
##   tiles('kind', 'color', nums(.., 3))    every tile of a kind: x z y
##   piece('model', from, 'clip', t, to, dt)  a piece: x z y hx hz now,
##     its clip and the time into it, and x z y in dt seconds
##   particles('kind', place, rate, wind, seed)  for a piece whose
##     model begins with a star: a burst there
##   eye(place, look, lens, dt)             for the piece "eye": the
##     scene seen from there, with perspective (after camera: it wins)
## x is east, z south, y up, in tiles.
l:s_cene := { (stage, models, clips, pieces, _) ->
  (map, frame, _, _, ground, smooth) := stage
  w := 3 s_elect frame
  h := 4 s_elect frame
  a := ((0.5 * w) - f_irst frame) / h:tw
  b := ((0.5 * h) - 2 s_elect frame) / h:th
  target := (0.5 * a + b) c_at 0.0 c_at 0.5 * b - a
  size := "view(" c_at (f_ormat h:w_hole w) c_at ", " c_at (f_ormat h:w_hole h) c_at ", '#1d1f2b')\n"
  camera := "camera(" c_at (h:n_ums (target, 3)) c_at "[0], " c_at (h:n_ums (0.6124 0.5 0.6124, 3)) c_at "[0], " c_at (f_ormat h:f_ine h:tw * 2.0 ^ 0.5) c_at ")\n"
  n := t_ally pieces
  both := (map, smooth) h:s_tands ((1 2) s_elect_2 pieces) c_at (6 7) s_elect_2 pieces
  now := n t_ake both
  soon := n d_rop both
  calls := '{ i -> e_nclose h:p_ieceCall (d_isclose f_irst (i - 1) d_rop models, d_isclose f_irst (i - 1) d_rop clips, i s_elect now, i s_elect soon, i s_elect pieces) } e_ach r_ange t_ally pieces
  ((size c_at camera) c_at ground) c_at t:j_oin calls
}
