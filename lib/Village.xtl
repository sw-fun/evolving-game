## Village: what stands behind the castle's wall, worked out as arrays
## from a seed (docs/plan.md, The castle as one game): a village of
## houses, halls and market stalls along winding streets, with watch
## towers and a keep among them. Another seed is another village. It
## is scenery: the buildings are models (assets/Castle.xtl) stood many
## times, smoke rises from some chimneys, and nothing here is a rule of
## any game.
##
## A village is laid out from its seed, its width and its depth alone,
## about the castle's gate: x east of the gate's middle, z south of the
## wall's north face (so every lot's z is negative). The map it stands
## behind has no say in it, so the same seed is the same village behind
## every map (the castle's map and the battlefield show one village).
## Its streets run east and west and wind as they go; a lot is a place
## beside a street, each side of it, facing it. Where the keep stands,
## and along the way from the gate to it, no lot is built on.
##
## x is east, z south, y up, as in every scene.
## Import: "vg:" u_se< "Village"

"rg:" u_se< "Rng"
"t:" u_se< "Text"
"tr:" u_se< "Terrain"
"w:" u_se< "World"

## How far round the map the ground goes before it is level with the
## world beyond (lib/View's band).
h:far := 24.0

### The lots

## A village is a maze of its houses: its streets are the open blocks of
## a maze carved from its seed (a sidewinder: every street joins every
## other one way only), its houses stand on the closed blocks, a market
## of stalls lines the street along the wall, a watch tower stands at
## each corner, and the keep stands in a square at the far end. A block
## is a tile; blocks row 0 is the far (north) edge, the last the edge by
## the wall.

## The maze's open blocks, a matrix bh by bw (1 a street), for cw by ch
## cells: each cell a street block, each opening between two cells a
## street block too. In every row a run of cells is carved east, and
## from each run one cell opens south, but in the last row (by the
## wall), which runs east all along.
h:c_arve := { (seed, cw, ch) ->
  bw := 1 + 2 * cw
  bh := 1 + 2 * ch
  n := cw * ch
  k := (r_ange n) - 1
  i := k d_iv cw
  j := k m_od cw
  east := (j < cw - 1) & (i = ch - 1) | 0.5 > (seed, 11) rg:u_nit r_ange n
  ends := 0 + n_ot east
  run := ('+ s_\ ends) - ends
  key := (seed, 12) rg:u_nit r_ange n
  best := 'm_ax r_/_2 (f_loat 0 + run '= t_able run) * (n c_at n) r_eshape key
  south := (i < ch - 1) & key = best
  cell := 1 + (bw * 1 + 2 * i) + 1 + 2 * j
  open := cell c_at (east r_eplicate cell + 1) c_at south r_eplicate cell + bw
  (bh c_at bw) r_eshape (r_ange bh * bw) m_ember? open
}
# :: (Int, Float, Float) -> Float
## Every lot of a village: (seed, wide, deep) to a table, a row a lot:
## x and z (from the gate: x east of its middle, z south of the wall's
## north face, so every z is negative), its kind (1 a house, 2 a hall,
## 3 a stall, 4 a watch tower, 5 the keep), and the way it faces (hx
## hz). wide and deep are the village's size in tiles (odd: the maze's
## blocks).
l:l_ots := { (seed, wide, deep) ->
  bw := 1 + 2 * f_loor (wide - 1.0) / 2.0
  bh := 1 + 2 * f_loor (deep - 1.0) / 2.0
  mid := bw d_iv 2
  r := ((r_ange bh * bw) - 1) d_iv bw
  c := ((r_ange bh * bw) - 1) m_od bw
  square := (r <= 5) & (a_bs c - mid) <= 4
  gap := (r = bh - 1) & c = mid
  street := (r_avel h:c_arve (seed, (bw - 1) d_iv 2, (bh - 1) d_iv 2)) | square | gap
  corner := ((c = 0) | c = bw - 1) & (r = 0) | r = bh - 1
  u := (seed, 13) rg:u_nit r_ange bh * bw
  stall := street & (r = bh - 2) & (n_ot square) & u < 0.35
  keep := (r = 2) & c = mid
  house := (n_ot street) & n_ot corner
  kind := ((1 + u > 0.8) * house) + (3 * stall) + (4 * corner) + 5 * keep
  any := kind > 0
  x := (f_loat c - mid) + 0.15 * (u - 0.5)
  z := (f_loat r - bh) + 0.5
  hz := 1.0 - 2.0 * f_loat r < 2
  o_\ (5 c_at '+ r_/ any) r_eshape (any r_eplicate x) c_at (any r_eplicate z) c_at (f_loat any r_eplicate kind) c_at (('+ r_/ any) r_eshape 0.0) c_at any r_eplicate hz
}

### Standing them

## Where a village's own gate point is in a map's scene, (map, south):
## east and west, the middle of the map's gate; north and south, the
## north face of the gate's wall, or, where the map is the village's
## own ground (south is not negative), the line that far south (the
## map's south edge: the village then stands on the map).
h:o_rigin := { (map, south) ->
  g := w:g_ate map
  x := (f_loat 2 s_elect g) - 0.5
  south >= 0.0 ? x c_at south
  h:t_urned map ? x c_at f_loat f_irst g
  x c_at (f_loat f_irst g) - 1.0
}
## Is a map turned (its entrance north of its gate, as a map seen from
## behind its wall is)? Its village then stands south of the gate, and
## turned too.
h:t_urned := { map -> (f_irst f_irst w:e_ntrances map) < f_irst w:g_ate map }
## The height of the ground at a map's points (x, z a row), on the map
## and off it: on it, the surface (lib/Terrain); off it, the nearest
## tile's, falling to the world beyond over the band.
h:g_round := { map xz ->
  rc := f_loat w:s_ize map
  x := f_irst_2 xz
  z := 2 s_elect_2 xz
  out := (0.0 - z) m_ax (z - f_irst rc) m_ax (0.0 - x) m_ax (x - 2 s_elect rc) m_ax 0.0
  (map tr:h_eight xz) * 0.0 m_ax 1.0 - out / h:far
}
h:f_ine := { v -> (f_loat f_loor 0.5 + 1000.0 * v) / 1000.0 }
## The scene's line for every row of one kind: tiles('name', 'color',
## nums('x z y base hx hz ...', 6), 'model'), names the kinds' models.
h:k_indCall := { (map, lots, names) k ->
  mine := (k = f_loor 3 s_elect_2 lots) r_eplicate lots
  0 = t_ally mine ? ""
  y := map h:g_round (1 2) s_elect_2 mine
  rows := o_\ (6 c_at t_ally mine) r_eshape (f_irst_2 mine) c_at (2 s_elect_2 mine) c_at y c_at y c_at (4 s_elect_2 mine) c_at 5 s_elect_2 mine
  name := d_isclose k s_elect names
  "tiles('" c_at name c_at "', '#8a8f98', nums('" c_at (f_ormat h:f_ine r_avel rows) c_at "', 6), '" c_at name c_at "')\n"
}
# :: (Any a, Num b) => ((a, Int, b), Float, Box Char) -> Char
## Things stood on a map's ground, as a scene's lines: (map, rows,
## names), rows a table as a village's lots (x, z, kind, hx, hz), names
## the model of each kind. A line a kind: a model stood many times.
## What a camp or any other scenery made of models is written with.
l:s_tood := { (map, rows, names) -> t:j_oin '{ k -> e_nclose (map, rows, names) h:k_indCall k } e_ach r_ange t_ally names }
# :: (Any a, Num b) => (a, Int, b) -> Float -> Float
## The height of a map's ground at points (x, z a row), on the map and
## off it.
l:g_round := { map xz -> map h:g_round xz }
# :: (Any a, Any b) => ((a, Int, b), Int, Float, Float, Float) -> Float
## A village's lots where they stand by a map: (map, seed, wide, deep,
## south), l:l_ots's table with x and z the scene's. south negative,
## it stands behind the map's wall, from its gate; else on the map,
## its own wall line that far south (h:o_rigin).
l:b_ehind := { (map, seed, wide, deep, south) ->
  lots := l:l_ots (seed, wide, deep)
  o := h:o_rigin (map, south)
  s := 1.0 - 2.0 * f_loat (south < 0.0) & h:t_urned map
  o_\ (5 c_at t_ally lots) r_eshape ((f_irst o) + s * f_irst_2 lots) c_at ((2 s_elect o) + s * 2 s_elect_2 lots) c_at (3 s_elect_2 lots) c_at (s * 4 s_elect_2 lots) c_at s * 5 s_elect_2 lots
}
# :: (Any a, Any b, Truthy c) => ((a, Int, b), Int, Float, Float, Float) -> c
## The tiles of a map a village's buildings stand on, a matrix of the
## map's shape, 1 where one does: (map, seed, wide, deep, south). A
## house, a hall or a watch tower takes the tile it stands in, the keep
## the tiles within two of its middle; a stall is open to walk under.
## A game on foot does not let you into them.
l:b_locked := { (map, seed, wide, deep, south) ->
  lots := l:b_ehind (map, seed, wide, deep, south)
  rc := w:s_ize map
  rows := f_irst rc
  cols := 2 s_elect rc
  kind := f_loor 3 s_elect_2 lots
  col := 1 + f_loor f_irst_2 lots
  row := 1 + f_loor 2 s_elect_2 lots
  inside := (col >= 1) & (col <= cols) & (row >= 1) & row <= rows
  at := (inside & kind m_ember? 1 2 4) r_eplicate col + cols * row - 1
  all := r_ange rows * cols
  keep := f_irst (kind = 5) r_eplicate lots
  cx := 0.5 + f_loat (all - 1) m_od cols
  cz := 0.5 + f_loat (all - 1) d_iv cols
  near := ((a_bs cx - f_irst keep) < 2.0) & (a_bs cz - 2 s_elect keep) < 2.0
  rc r_eshape (all m_ember? at) | near
}
# :: (Any a, Num b) => ((a, Int, b), Int, Float, Float, Float) -> Char
## A village as a scene's lines: (map, seed, wide, deep, south). Every
## lot of a kind is one line (a model stood many times), and from one
## house or hall in six smoke rises (the wind from the west).
l:c_alls := { (map, seed, wide, deep, south) ->
  lots := l:b_ehind (map, seed, wide, deep, south)
  built := l:s_tood (map, lots, "house" "hall" "stall" "watch" "keep")
  homes := ((3 s_elect_2 lots) < 3.0) r_eplicate lots
  smoking := (0 = ((r_ange t_ally homes) m_od 6)) r_eplicate homes
  y := map h:g_round (1 2) s_elect_2 smoking
  s_moke := { j -> "particles('smoke', nums('" c_at (f_ormat h:f_ine (2 t_ake j s_elect smoking) c_at 1.5 + j s_elect y) c_at "', 3)[0], 5, nums('0.35 0.1', 2)[0], " c_at (f_ormat 100 + j) c_at ")\n" }
  built c_at t:j_oin '{ j -> e_nclose s_moke j } e_ach r_ange t_ally smoking
}
